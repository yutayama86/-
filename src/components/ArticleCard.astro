---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '../content.config';
import { formatDate } from '../lib/content';

interface Props {
  article: CollectionEntry<'articles'>;
  size?: 'sm' | 'md' | 'lg';
  index?: number;
}
const { article, size = 'md', index } = Astro.props;
const { data } = article;
const cat = CATEGORIES[data.category];
const href = `/${cat.path}/${article.id.split('/').pop()}/`;
---

<article class={`card card--${size}`} data-reveal>
  <a href={href} class="card-link" aria-label={data.title}>
    <div class="card-media">
      {data.cover ? (
        <img src={data.cover} alt={data.coverAlt} loading="lazy" decoding="async" />
      ) : (
        <div class="card-fallback" style={`--_a:${cat.accent}`}>
          <span class="mincho">{cat.label}</span>
        </div>
      )}
      <span class="card-cat" style={`--_a:${cat.accent}`}>{cat.label}</span>
      {index !== undefined && <span class="card-idx latin">{String(index + 1).padStart(2, '0')}</span>}
    </div>
    <div class="card-body">
      <div class="card-meta">
        {data.area && <span>{data.area}</span>}
        <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
      </div>
      <h3 class="card-title display">{data.title}</h3>
      {size !== 'sm' && <p class="card-desc">{data.description}</p>}
      {data.reporter && <p class="card-reporter">取材：{data.reporter}</p>}
    </div>
  </a>
</article>

<style>
  .card { position: relative; }
  .card-link { display: grid; gap: 1rem; }
  .card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-3);
  }
  .card--lg .card-media { aspect-ratio: 16 / 10; }
  .card-media img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.9s var(--ease), filter 0.6s;
  }
  .card-link:hover .card-media img { transform: scale(1.06); }
  .card-fallback {
    width: 100%; height: 100%; display: grid; place-items: center;
    background: linear-gradient(135deg, color-mix(in srgb, var(--_a) 16%, var(--paper-2)), var(--paper-3));
    color: color-mix(in srgb, var(--_a) 80%, var(--ink));
  }
  .card-fallback span { font-size: var(--step-2); opacity: 0.5; letter-spacing: 0.2em; }
  .card-cat {
    position: absolute; top: 0.9rem; left: 0.9rem;
    background: color-mix(in srgb, var(--_a) 92%, black 0%);
    color: #fff; font-size: var(--step--1); font-weight: 700;
    padding: 0.3em 0.85em; border-radius: 999px; letter-spacing: 0.05em;
  }
  .card-idx {
    position: absolute; bottom: 0.6rem; right: 0.9rem;
    color: #fff; font-size: var(--step-2); mix-blend-mode: difference; opacity: 0.9;
  }
  .card-meta {
    display: flex; gap: 0.9rem; align-items: center;
    font-size: var(--step--1); color: var(--ink-mute); letter-spacing: 0.04em;
  }
  .card-meta time { font-family: var(--font-latin); }
  .card-title {
    font-size: var(--step-1); line-height: 1.4; color: var(--ink);
    transition: color 0.3s;
  }
  .card--lg .card-title { font-size: var(--step-2); }
  .card-link:hover .card-title { color: var(--shu-deep); }
  .card-desc {
    color: var(--ink-soft); font-size: var(--step-0);
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .card-reporter { font-size: var(--step--1); color: var(--ink-mute); }
</style>
