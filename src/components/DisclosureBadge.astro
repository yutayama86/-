---
/**
 * DisclosureBadge — 記事の区分（Editorial / Partner / PR）を明示する。
 * Blueprintの Editorial Contract に基づき、色だけでなく文言で伝える。
 * 有料関係（Partner/PR）は編集記事と視覚・文言で明確に区別する。
 */
interface Props {
  type?: 'editorial' | 'partner' | 'pr';
  note?: string; // 情報提供・費用負担・招待などの補足
  compact?: boolean;
}
const { type = 'editorial', note, compact = false } = Astro.props;

const META = {
  editorial: { label: '編集記事', sub: '編集部の独立した取材・編集', cls: 'is-editorial' },
  partner: { label: 'パートナー（関係を開示）', sub: '支援関係のある取材コンテンツ', cls: 'is-partner' },
  pr: { label: 'PR（広告）', sub: '費用を伴う広告コンテンツ', cls: 'is-pr' },
} as const;
const m = META[type];
---

<span class:list={['disclosure', m.cls, { 'is-compact': compact }]} role="note" aria-label={`区分: ${m.label}`}>
  <span class="disclosure__label">{m.label}</span>
  {!compact && <span class="disclosure__sub">{note ?? m.sub}</span>}
</span>

<style>
  .disclosure {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55em;
    font-family: var(--font-brand-meta);
    font-size: 0.8rem;
    line-height: 1.3;
    padding: 0.3em 0.7em;
    border: 1px solid var(--color-mist);
    border-radius: var(--radius-xs);
    background: var(--color-white);
  }
  .disclosure__label {
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .disclosure__sub { color: var(--color-soil); font-size: 0.75rem; }

  /* 区分ごとの識別（左罫＋文言。色のみに依存しない） */
  .is-editorial { border-left: 3px solid var(--color-tide); }
  .is-partner { border-left: 3px solid var(--color-brass); }
  .is-partner .disclosure__label { color: var(--color-brass); }
  .is-pr { border-left: 3px solid var(--color-signal); background: color-mix(in srgb, var(--color-signal) 6%, var(--color-white)); }
  .is-pr .disclosure__label { color: var(--color-signal); }

  .is-compact { padding: 0.15em 0.5em; font-size: 0.72rem; }
</style>
