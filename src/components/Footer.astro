---
import { NAV, BIZ_NAV, SITE_CONFIG } from '../data/site';
const year = new Date().getFullYear();
// 公式アカウントの実URLが設定されているものだけ表示（汎用トップURLは出さない）
const socials = [
  { label: 'Instagram', href: SITE_CONFIG.social.instagram },
  { label: 'TikTok', href: SITE_CONFIG.social.tiktok },
  { label: 'X', href: SITE_CONFIG.social.x },
  { label: 'Threads', href: SITE_CONFIG.social.threads },
].filter((s) => s.href && s.href.length > 0);
---

<!-- 事業者向けの帯（階層4 制圧導線）を全ページ足元に -->
<section class="biz-band">
  <div class="wrap biz-band-inner">
    <p class="eyebrow" style="color: rgba(245,241,232,.6)">For Business Owners</p>
    <h2 class="display biz-band-title">
      「イバトコから、お客さんが来た」<br />
      その一歩を、いっしょに。
    </h2>
    <p class="biz-band-lead">
      掲載は初期費用0円から。取材・撮影・専用ページ制作までワンストップ。<br class="pc" />
      集客が動き出したら、公式HP・SNS運用・予約システムまで丸ごとお任せください。
    </p>
    <div class="biz-band-actions">
      <a href="/biz/" class="btn btn--shu btn--lg">無料掲載を相談する <span class="arw">→</span></a>
      <a href="/agency/" class="btn btn--ghost btn--lg" style="--fg:#f5f1e8;border-color:rgba(245,241,232,.35)">WEB集客サポートを見る</a>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="wrap-wide ft-grid">
    <div class="ft-brand">
      <a href="/" class="ft-logo display">イバトコ</a>
      <p class="ft-tag mincho">{SITE_CONFIG.tagline}</p>
      {socials.length > 0 && (
        <ul class="ft-social">
          {socials.map((s) => (
            <li><a href={s.href} class="ul-link" target="_blank" rel="noopener noreferrer">{s.label}</a></li>
          ))}
        </ul>
      )}
    </div>

    <nav class="ft-col" aria-label="コンテンツ">
      <h3 class="ft-h">よみもの</h3>
      <ul>{NAV.map((n) => <li><a href={n.href} class="ul-link">{n.label}</a></li>)}</ul>
    </nav>

    <nav class="ft-col" aria-label="事業者の方へ">
      <h3 class="ft-h">事業者の方へ</h3>
      <ul>{BIZ_NAV.map((n) => <li><a href={n.href} class="ul-link">{n.label}</a></li>)}</ul>
    </nav>

    <nav class="ft-col" aria-label="サイト情報">
      <h3 class="ft-h">イバトコについて</h3>
      <ul>
        <li><a href="/about/" class="ul-link">運営・編集方針</a></li>
        <li><a href="/reporters/" class="ul-link">公式レポーター</a></li>
        <li><a href="/place/" class="ul-link">店舗ディレクトリ</a></li>
        <li><a href="/guide/" class="ul-link">まとめ・モデルコース</a></li>
        <li><a href="/privacy/" class="ul-link">プライバシーポリシー</a></li>
      </ul>
    </nav>
  </div>

  <div class="wrap-wide ft-base">
    <p class="latin">© {year} {SITE_CONFIG.nameEn} — Ibaraki Local Media</p>
    <p class="muted">茨城の“いいとこ”、まだまだあります。</p>
  </div>
</footer>

<style>
  .biz-band {
    background:
      radial-gradient(120% 140% at 15% 0%, #1c4160 0%, var(--ai-deep) 55%, #0a1a28 100%);
    color: var(--paper);
    padding: clamp(3.5rem, 8vw, 6.5rem) 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .biz-band::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(60% 60% at 85% 100%, rgba(216,69,43,.28), transparent 70%);
    pointer-events: none;
  }
  .biz-band-inner { position: relative; }
  .biz-band-title { font-size: var(--step-4); font-weight: 600; margin: 0.6rem 0 1.2rem; }
  .biz-band-lead { color: rgba(245,241,232,.82); font-size: var(--step-1); line-height: 1.9; margin-bottom: 2.2rem; }
  .biz-band-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  .site-footer { background: var(--ink); color: var(--paper); padding: clamp(3rem, 6vw, 5rem) 0 2rem; }
  .ft-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(245,241,232,.14);
  }
  .ft-logo { font-size: var(--step-2); color: var(--paper); }
  .ft-tag { color: rgba(245,241,232,.7); margin-top: 0.6rem; font-size: var(--step-0); }
  .ft-social { display: flex; gap: 1.2rem; margin-top: 1.4rem; flex-wrap: wrap; }
  .ft-social a { color: rgba(245,241,232,.85); font-size: var(--step--1); letter-spacing: 0.06em; }
  .ft-h { font-size: var(--step--1); letter-spacing: 0.16em; color: rgba(245,241,232,.5); margin-bottom: 1rem; font-weight: 700; }
  .ft-col ul { display: flex; flex-direction: column; gap: 0.7rem; }
  .ft-col a { color: rgba(245,241,232,.85); font-size: var(--step-0); }
  .ft-base {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding-top: 1.6rem; flex-wrap: wrap;
  }
  .ft-base p { font-size: var(--step--1); color: rgba(245,241,232,.6); }

  .pc { display: inline; }
  @media (max-width: 760px) {
    .pc { display: none; }
    .ft-grid { grid-template-columns: 1fr 1fr; }
    .ft-brand { grid-column: 1 / -1; }
  }
</style>
