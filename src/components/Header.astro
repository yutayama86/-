---
import { NAV, SITE_CONFIG } from '../data/site';
const path = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="wrap-wide hd-inner">
    <a href="/" class="brand" aria-label={`${SITE_CONFIG.name} ホーム`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="34" height="34" fill="none">
          <path d="M20 3 L34 11 V29 L20 37 L6 29 V11 Z" stroke="currentColor" stroke-width="1.6" fill="none"/>
          <path d="M20 12 v16 M13 20 h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="brand-type">
        <b class="brand-ja">イバトコ</b>
        <em class="brand-en latin">IBATOCO</em>
      </span>
    </a>

    <nav class="hd-nav" aria-label="メインナビゲーション">
      {NAV.map((item) => (
        <a
          href={item.href}
          class="hd-link ul-link"
          aria-current={path.startsWith(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <div class="hd-actions">
      <a href="/biz/" class="btn btn--shu hd-cta">
        掲載のご案内
        <span class="arw" aria-hidden="true">→</span>
      </a>
      <button class="hd-burger" data-burger aria-label="メニューを開く" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="hd-drawer" data-drawer hidden>
    <nav aria-label="モバイルナビゲーション">
      {NAV.map((item) => (
        <a href={item.href} class="drawer-link display">{item.label}</a>
      ))}
      <hr class="rule" />
      <a href="/biz/" class="drawer-link drawer-sub">掲載のご案内（事業者様）</a>
      <a href="/agency/" class="drawer-link drawer-sub">WEB集客サポート</a>
      <a href="/contact/" class="drawer-link drawer-sub">お問い合わせ</a>
      <a href="/biz/" class="btn btn--shu btn--lg" style="margin-top:1.5rem">
        無料掲載を相談する <span class="arw">→</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s, background 0.4s, transform 0.5s var(--ease);
  }
  .site-header[data-scrolled] { border-bottom-color: var(--line); }
  .site-header[data-hidden] { transform: translateY(-100%); }

  .hd-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 74px;
  }

  .brand { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--ai); }
  .brand-mark { color: var(--shu); display: grid; place-items: center; }
  .brand-type { display: flex; flex-direction: column; line-height: 1; }
  .brand-ja { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; letter-spacing: 0.08em; color: var(--ink); }
  .brand-en { font-size: 0.6rem; letter-spacing: 0.45em; color: var(--ink-mute); margin-top: 3px; font-style: normal; }

  .hd-nav { display: flex; gap: clamp(0.7rem, 1.5vw, 1.5rem); }
  .hd-link { font-size: var(--step--1); font-weight: 700; letter-spacing: 0.02em; color: var(--ink-soft); padding: 0.4em 0; white-space: nowrap; }
  .hd-link[aria-current="page"] { color: var(--shu); }

  .hd-actions { display: flex; align-items: center; gap: 0.75rem; }
  .hd-cta { white-space: nowrap; }

  .hd-burger {
    display: none;
    width: 44px; height: 44px;
    background: none; border: 1px solid var(--line-strong); border-radius: 999px;
    position: relative;
  }
  .hd-burger span {
    position: absolute; left: 50%; top: 50%; width: 18px; height: 1.6px; background: var(--ink);
    transform: translate(-50%, -50%); transition: transform 0.35s var(--ease), opacity 0.2s;
  }
  .hd-burger span:first-child { transform: translate(-50%, -5px); }
  .hd-burger span:last-child { transform: translate(-50%, 5px); }
  .hd-burger[aria-expanded="true"] span:first-child { transform: translate(-50%, -50%) rotate(45deg); }
  .hd-burger[aria-expanded="true"] span:last-child { transform: translate(-50%, -50%) rotate(-45deg); }

  .hd-drawer {
    border-top: 1px solid var(--line);
    background: var(--paper);
    padding: 1.5rem var(--gutter) 2.5rem;
  }
  .hd-drawer nav { display: flex; flex-direction: column; gap: 0.25rem; }
  .drawer-link { font-size: var(--step-2); font-weight: 600; color: var(--ink); padding: 0.5rem 0; }
  .drawer-sub { font-size: var(--step-0); color: var(--ink-soft); font-family: var(--font-sans); }

  @media (max-width: 900px) {
    .hd-nav, .hd-cta { display: none; }
    .hd-burger { display: block; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');

  // Scroll behavior: hide on scroll down, show on up
  let last = 0;
  const onScroll = () => {
    const y = window.scrollY;
    if (!header) return;
    header.toggleAttribute('data-scrolled', y > 8);
    if (y > 400 && y > last && !drawer?.classList.contains('open')) {
      header.setAttribute('data-hidden', '');
    } else {
      header.removeAttribute('data-hidden');
    }
    last = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute('aria-label', open ? 'メニューを開く' : 'メニューを閉じる');
    if (drawer) {
      drawer.hidden = open;
      drawer.classList.toggle('open', !open);
    }
    document.body.style.overflow = open ? '' : 'hidden';
  });
</script>
