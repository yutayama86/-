---
const themes = [
  { label: '食べる', path: 'eat', desc: '干し芋、あんこう、常陸秋そば。海の町の朝と、畑の町の昼。', cta: '食の物語へ', bg: '#E5C792', icon: 'eat' },
  { label: '出かける', path: 'sauna-play', desc: '袋田の滝、筑波山、ネモフィラの丘、五浦の海。休日の行き先を見つける。', cta: '休日の行き先へ', bg: '#A7D2EE', icon: 'go' },
  { label: '泊まる', path: 'stay', desc: '海沿いの宿、山あいの一軒宿。朝の光ごと、茨城に身を置く。', cta: '宿を探す', bg: '#B8C6DF', icon: 'stay' },
  { label: '暮らす', path: 'life', desc: '直売所、朝市、季節の手仕事。この土地の普通の一日を訪ねる。', cta: '日常を訪ねる', bg: '#C2D2A2', icon: 'life' },
  { label: '整える', path: 'beauty', desc: '温泉、サウナ、湖のほとり。身体をゆるめる場所を知る。', cta: '整う場所へ', bg: '#E3BDB5', icon: 'wellbeing' },
  { label: '働く・つくる', path: 'company', desc: '笠間焼、結城紬、醸造、農場。受け継がれてきた技と、それを継ぐ人。', cta: '仕事と人へ', bg: '#A7C1BA', icon: 'work' },
];
---
<nav class="theme-nav" aria-label="テーマから探す">
  <ol>
    {themes.map((theme, i) => (
      <li style={`--theme-color:${theme.bg}`}>
        <a href={`/${theme.path}/`}>
          <span class="tn-num">0{i + 1}</span>
          <span class="tn-icon" aria-hidden="true">
            {theme.icon === 'eat' && <svg viewBox="0 0 48 48"><path d="M8 25h32M11 25c1 9 6 14 13 14s12-5 13-14M17 20c0-3 2-5 5-6M27 19c0-3 2-5 5-6" /></svg>}
            {theme.icon === 'go' && <svg viewBox="0 0 48 48"><path d="M8 35c7-1 10-7 16-7s9 6 16 7M12 27l9-13 7 10 4-6 6 9M24 8v7" /></svg>}
            {theme.icon === 'stay' && <svg viewBox="0 0 48 48"><path d="M15 38h18M17 38V19h14v19M20 19c0-5 2-8 4-8s4 3 4 8M21 25h6M24 25v8" /></svg>}
            {theme.icon === 'life' && <svg viewBox="0 0 48 48"><path d="M11 23h26l-3 15H14l-3-15ZM18 23c0-5 2-8 6-8s6 3 6 8M19 30h10M31 12c3 0 5 2 5 5-3 0-5-2-5-5Z" /></svg>}
            {theme.icon === 'wellbeing' && <svg viewBox="0 0 48 48"><path d="M9 31c4 5 9 8 15 8s11-3 15-8M13 27h22M18 21c-3-4 2-6 0-10M27 21c-3-4 2-6 0-10M35 21c-3-4 2-6 0-10" /></svg>}
            {theme.icon === 'work' && <svg viewBox="0 0 48 48"><path d="M17 17h14M18 17c0 4-2 6-2 11 0 7 4 10 8 10s8-3 8-10c0-5-2-7-2-11M14 26c-4 1-6 4-6 8M34 26c4 1 6 4 6 8M19 29h10" /></svg>}
          </span>
          <span class="tn-title">{theme.label}</span>
          <span class="tn-desc">{theme.desc}</span>
          <span class="tn-cta">{theme.cta} <span aria-hidden="true">→</span></span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .theme-nav{overflow:hidden}
  .theme-nav ol{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));border-block:1px solid color-mix(in srgb,var(--color-ink) 32%,transparent)}
  .theme-nav li{min-width:0;border-right:1px solid color-mix(in srgb,var(--color-ink) 20%,transparent)}
  .theme-nav li:last-child{border-right:0}
  .theme-nav a{position:relative;display:grid;grid-template-columns:1fr auto;grid-template-rows:auto 3.7rem auto 1fr auto;column-gap:.5rem;height:100%;min-height:17.5rem;padding:1rem clamp(.75rem,1.15vw,1.15rem) .9rem;color:var(--color-ink);transition:background-color .25s ease,box-shadow .25s ease}
  .tn-num{font:600 .62rem/1 var(--font-brand-meta);letter-spacing:.1em;color:var(--color-soil)}
  .tn-icon{grid-column:2;grid-row:1/3;display:grid;place-items:center;width:3.35rem;height:3.35rem;background:color-mix(in srgb,var(--theme-color) 78%,#fff);border-radius:54% 46% 61% 39% / 43% 58% 42% 57%;transform:rotate(2deg);transition:transform .35s cubic-bezier(.2,.7,.2,1),background-color .25s ease,border-radius .35s ease}
  .tn-icon svg{width:2rem;height:2rem;fill:none;stroke:var(--color-ink);stroke-width:1.45;stroke-linecap:round;stroke-linejoin:round}
  .tn-title{grid-column:1/-1;grid-row:3;font:600 clamp(1.25rem,1.55vw,1.65rem)/1.25 var(--font-brand-display);letter-spacing:.015em;text-wrap:balance}
  .tn-desc{grid-column:1/-1;grid-row:4;margin-top:.55rem;font-size:.72rem;line-height:1.7;color:var(--color-soil)}
  .tn-cta{grid-column:1/-1;grid-row:5;display:flex;align-items:center;justify-content:space-between;padding-top:.65rem;border-top:1px solid color-mix(in srgb,var(--color-ink) 24%,transparent);font-size:.66rem;font-weight:700;white-space:nowrap}.tn-cta span{font-size:.9rem;transition:transform .25s ease}
  .theme-nav a::before{content:'';position:absolute;inset:0;background:color-mix(in srgb,var(--theme-color) 18%,transparent);opacity:0;transition:opacity .25s ease;pointer-events:none}
  .theme-nav a:hover,.theme-nav a:focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--color-ink)}
  .theme-nav a:hover::before,.theme-nav a:focus-visible::before{opacity:1}
  .theme-nav a:hover .tn-icon,.theme-nav a:focus-visible .tn-icon{transform:rotate(-4deg) scale(1.05);border-radius:43% 57% 44% 56% / 58% 39% 61% 42%;background:var(--theme-color)}
  .theme-nav a:hover .tn-cta span,.theme-nav a:focus-visible .tn-cta span{transform:translateX(4px)}
  @media(max-width:900px){.theme-nav{margin-inline:calc(var(--page-gutter,1.25rem) * -1);overflow-x:auto;scrollbar-width:none;overscroll-behavior-inline:contain;scroll-snap-type:x proximity}.theme-nav::-webkit-scrollbar{display:none}.theme-nav ol{grid-template-columns:repeat(6,10.5rem);width:max-content;padding-inline:var(--page-gutter,1.25rem);border-block:0}.theme-nav li{scroll-snap-align:start;border-block:1px solid color-mix(in srgb,var(--color-ink) 28%,transparent)}.theme-nav li:last-child{border-right:1px solid color-mix(in srgb,var(--color-ink) 20%,transparent)}.theme-nav a{min-height:14.5rem}.tn-title{font-size:1.35rem}.tn-desc{font-size:.7rem}}
</style>
