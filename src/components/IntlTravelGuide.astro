---
/**
 * 海外向け旅行ガイドの表示（英語・繁體中文・한국어 共通）。
 * 構成は §19 の共通テンプレート（Quick Answer → 本文 → FAQ → 出典）。
 * 文言はすべて data 側（言語ごと）に持たせ、この部品は言語を持たない。
 */
import type { IntlGuide } from '../data/intl-guides';

interface Props { guide: IntlGuide; }
const { guide } = Astro.props;
---

<article class="ig">
  <header class="ig-head bp-wrap">
    <h1>{guide.h1}</h1>
    <div class="ig-lead">{guide.lead.map((p) => <p>{p}</p>)}</div>
    <p class="ig-meta">
      <span>{guide.authorLabel}: {guide.author}</span>
      <span>{guide.updatedLabel}: <time datetime={guide.updatedDate}>{guide.updatedDate}</time></span>
    </p>
  </header>

  <div class="ig-body bp-wrap">
    {guide.routeChain && (
      <section class="ig-route" aria-labelledby="ig-route-title">
        <h2 id="ig-route-title">{guide.routeChain.label}</h2>
        <ol>
          {guide.routeChain.steps.map((step) => (
            <li>
              <strong>{step.place}</strong>
              {step.note && <small>{step.note}</small>}
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="ig-quick" aria-labelledby="ig-quick-title">
      <h2 id="ig-quick-title">{guide.quickAnswerLabel}</h2>
      <dl>{guide.quickAnswer.map((item) => <div><dt>{item.q}</dt><dd>{item.a}</dd></div>)}</dl>
    </section>

    {guide.sections.map((section) => (
      <section class="ig-section" id={section.id}>
        <h2>{section.heading}</h2>
        {section.body?.map((p) => <p>{p}</p>)}
        {section.table && <dl class="ig-table">{section.table.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}
        {section.list && <ul>{section.list.map((li) => <li>{li}</li>)}</ul>}
      </section>
    ))}

    <section class="ig-section" id="faq">
      <h2>{guide.faqLabel}</h2>
      <dl class="ig-faq">{guide.faq.map((item) => <div><dt>{item.q}</dt><dd>{item.a}</dd></div>)}</dl>
    </section>

    <aside class="ig-sources" aria-labelledby="ig-sources-title">
      <h2 id="ig-sources-title">{guide.sourcesLabel}</h2>
      <ul>{guide.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label} <span aria-hidden="true">↗</span></a></li>)}</ul>
      <p class="ig-disclaimer">{guide.disclaimer}</p>
    </aside>
  </div>
</article>

<style>
  .ig{padding-top:clamp(2.5rem,6vw,4.5rem)}
  .ig-head{padding-bottom:clamp(2rem,5vw,3.5rem);border-bottom:1px solid var(--color-mist)}
  .ig-head h1{max-width:24ch;font:600 clamp(2rem,5vw,3.6rem)/1.3 var(--font-brand-display);color:var(--color-ink)}
  .ig-lead{display:grid;gap:1rem;max-width:62ch;margin-top:1.4rem;color:var(--color-soil);line-height:1.95}
  .ig-meta{display:flex;flex-wrap:wrap;gap:.4rem 1.4rem;margin-top:1.5rem;color:var(--color-soil);font-size:.76rem}
  .ig-body{display:grid;gap:clamp(2.5rem,6vw,4rem);padding-block:clamp(2.5rem,6vw,4rem);max-width:var(--content-reading)}
  /* 東京からの経路を一目で追えるようにする連鎖表示。横スクロールで折り返さない。 */
  .ig-route h2{font:600 1.15rem var(--font-brand-display);color:var(--color-ink)}
  .ig-route ol{display:flex;flex-wrap:wrap;align-items:stretch;gap:.55rem;margin-top:1rem;padding:0;list-style:none}
  .ig-route li{display:grid;gap:.15rem;flex:0 1 auto;padding:.7rem .9rem;background:var(--color-white);border:1px solid var(--color-mist);border-radius:.5rem}
  .ig-route li+li{position:relative;margin-left:1.1rem}
  .ig-route li+li::before{content:'→';position:absolute;left:-1.05rem;top:50%;transform:translateY(-50%);color:var(--color-tide);font-size:.85rem}
  .ig-route strong{color:var(--color-ink);font-size:.88rem;font-weight:700;line-height:1.5}
  .ig-route small{color:var(--color-soil);font-size:.72rem;line-height:1.5}
  .ig-quick{padding:1.6rem;background:var(--color-white);border:1px solid var(--color-mist)}
  .ig-quick h2{font:600 1.15rem var(--font-brand-display);color:var(--color-ink)}
  .ig-quick dl{display:grid;gap:.9rem;margin-top:1.1rem}
  .ig-quick dt{font-weight:700;color:var(--color-ink);font-size:.9rem}
  .ig-quick dd{margin:.25rem 0 0;color:var(--color-soil);font-size:.9rem;line-height:1.8}
  .ig-section h2{font:600 clamp(1.4rem,2.8vw,2rem)/1.4 var(--font-brand-display);color:var(--color-ink)}
  .ig-section p{margin-top:1rem;color:var(--color-charcoal);line-height:2}
  .ig-section ul{display:grid;gap:.7rem;margin-top:1.1rem;padding-left:1.1rem}
  .ig-section li{color:var(--color-charcoal);line-height:1.9}
  .ig-table{margin-top:1.3rem;border-top:1px solid var(--color-mist)}
  .ig-table>div{display:grid;grid-template-columns:minmax(10rem,.8fr) minmax(0,1.6fr);gap:1rem;padding:1rem 0;border-bottom:1px solid var(--color-mist)}
  .ig-table dt{font-weight:700;color:var(--color-tide);font-size:.88rem}
  .ig-table dd{margin:0;color:var(--color-charcoal);line-height:1.85}
  .ig-faq{margin-top:1.2rem;border-top:1px solid var(--color-mist)}
  .ig-faq>div{padding:1.3rem 0;border-bottom:1px solid var(--color-mist)}
  .ig-faq dt{font-weight:700;color:var(--color-ink)}
  .ig-faq dd{margin:.5rem 0 0;color:var(--color-soil);line-height:1.9}
  .ig-sources{padding:1.6rem;background:var(--color-ink);color:var(--color-paper)}
  .ig-sources h2{font:600 1.05rem var(--font-brand-display);color:#fff}
  .ig-sources ul{margin-top:.9rem;list-style:none;padding:0;border-top:1px solid rgba(255,255,255,.2)}
  .ig-sources li a{display:block;padding:.65rem 0;border-bottom:1px solid rgba(255,255,255,.2);color:var(--color-paper);font-size:.84rem}
  .ig-sources li a:hover{color:#fff}
  .ig-disclaimer{margin-top:1.1rem;color:rgba(246,242,233,.8);font-size:.78rem;line-height:1.8}
  @media(max-width:640px){.ig-table>div{grid-template-columns:1fr;gap:.3rem}}
</style>
