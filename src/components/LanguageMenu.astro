---
/**
 * ヘッダー用の言語選択（ドロップダウン）。
 *  - 通常時は「現在の言語 ＋ ⌄」の1ボタン。開くと右揃えのメニューを表示する。
 *  - 対応ページがあればその記事へ、無ければその言語のトップへフォールバック。
 *  - 現在の言語は aria-current と「（現在の言語）」のテキストでも判別できる（色や印だけに依存しない）。
 *  - IP・ブラウザ言語による自動リダイレクトはしない。
 */
import { LOCALES, LOCALE_META, TRANSLATIONS, localeHome, type Locale } from '../data/i18n';

interface Props { locale: Locale; translationKey?: string; id: string; }
const { locale, translationKey, id } = Astro.props;

const map = translationKey ? TRANSLATIONS[translationKey] : undefined;
const items = LOCALES.map((code) => ({
  code,
  label: LOCALE_META[code].label,
  htmlLang: LOCALE_META[code].htmlLang,
  href: map?.[code] ?? localeHome(code),
  current: code === locale,
}));

const current = LOCALE_META[locale];
/** ボタンのラベルはUIの言語に合わせる（英語ページで「言語」と出さない）。 */
const ARIA_LABEL: Record<Locale, string> = {
  ja: '表示言語を選択',
  en: 'Select language',
  'zh-tw': '選擇語言',
  ko: '언어 선택',
};
const CURRENT_NOTE: Record<Locale, string> = {
  ja: '（現在の言語）',
  en: '(current language)',
  'zh-tw': '（目前語言）',
  ko: '(현재 언어)',
};
---

<div class="lang-menu" data-lang-menu>
  <button
    type="button"
    class="lang-menu__button"
    id={`${id}-button`}
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls={id}
    aria-label={ARIA_LABEL[locale]}
    data-lang-trigger
  >
    <span lang={current.htmlLang}>{current.label}</span>
    <svg class="lang-menu__caret" width="9" height="6" viewBox="0 0 9 6" aria-hidden="true" focusable="false">
      <path d="M1 1L4.5 4.5L8 1" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
    </svg>
  </button>

  <ul class="lang-menu__list" id={id} role="menu" aria-labelledby={`${id}-button`} hidden data-lang-list>
    {items.map((item) => (
      <li role="none">
        <a
          role="menuitem"
          href={item.href}
          hreflang={item.htmlLang}
          lang={item.htmlLang}
          aria-current={item.current ? 'true' : undefined}
          class:list={['lang-menu__item', { 'is-current': item.current }]}
          tabindex="-1"
        >
          <span class="lang-menu__check" aria-hidden="true">{item.current ? '✓' : ''}</span>
          <span>{item.label}</span>
          {item.current && <span class="sr-only">{CURRENT_NOTE[locale]}</span>}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .lang-menu{position:relative}
  .lang-menu__button{display:inline-flex;align-items:center;gap:.5rem;padding:.4rem .65rem;border:1px solid var(--color-mist);border-radius:1px;background:color-mix(in srgb,var(--color-paper) 60%,var(--color-white));color:var(--color-ink);font:500 .78rem/1.4 var(--font-brand-body);white-space:nowrap;cursor:pointer;transition:background-color .2s ease,border-color .2s ease}
  .lang-menu__button:hover{background:color-mix(in srgb,var(--color-ink) 5%,var(--color-white));border-color:color-mix(in srgb,var(--color-ink) 22%,transparent)}
  .lang-menu__button:focus-visible{outline:2px solid var(--color-tide);outline-offset:2px}
  .lang-menu__caret{flex:none;color:var(--color-soil);transition:transform .2s ease}
  .lang-menu__button[aria-expanded='true'] .lang-menu__caret{transform:rotate(180deg)}

  .lang-menu__list{position:absolute;top:calc(100% + .5rem);right:0;z-index:40;width:190px;margin:0;padding:.25rem 0;list-style:none;border:1px solid var(--color-mist);background:var(--color-white);box-shadow:0 2px 10px rgba(23,43,53,.06)}
  .lang-menu__list[hidden]{display:none}
  .lang-menu__item{display:flex;align-items:center;gap:.5rem;min-height:44px;padding:.5rem .9rem;color:var(--color-ink);font:500 .85rem/1.5 var(--font-brand-body);transition:background-color .18s ease}
  .lang-menu__item:hover{background:color-mix(in srgb,var(--color-paper) 70%,var(--color-white))}
  .lang-menu__item:focus-visible{outline:2px solid var(--color-tide);outline-offset:-2px}
  .lang-menu__item.is-current{background:color-mix(in srgb,var(--color-paper) 92%,var(--color-white));font-weight:700}
  .lang-menu__check{flex:none;width:.9rem;color:var(--color-tide);font-size:.75rem;text-align:center}

  @media(max-width:560px){.lang-menu__list{width:180px}}
</style>

<script>
  // 開閉・キーボード操作・外側クリック。ページ内に複数あっても動く。
  document.querySelectorAll<HTMLElement>('[data-lang-menu]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('[data-lang-trigger]');
    const list = root.querySelector<HTMLElement>('[data-lang-list]');
    if (!trigger || !list) return;
    const items = () => [...list.querySelectorAll<HTMLAnchorElement>('a[role="menuitem"]')];

    const open = (focusIndex?: number) => {
      list.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      if (focusIndex !== undefined) items()[focusIndex]?.focus();
    };
    const close = (returnFocus = false) => {
      list.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (returnFocus) trigger.focus();
    };
    const isOpen = () => !list.hidden;

    trigger.addEventListener('click', () => (isOpen() ? close() : open()));
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        open(0);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        open(items().length - 1);
      }
    });

    list.addEventListener('keydown', (event) => {
      const all = items();
      const index = all.indexOf(document.activeElement as HTMLAnchorElement);
      if (event.key === 'ArrowDown') { event.preventDefault(); all[(index + 1) % all.length]?.focus(); }
      else if (event.key === 'ArrowUp') { event.preventDefault(); all[(index - 1 + all.length) % all.length]?.focus(); }
      else if (event.key === 'Home') { event.preventDefault(); all[0]?.focus(); }
      else if (event.key === 'End') { event.preventDefault(); all[all.length - 1]?.focus(); }
      else if (event.key === 'Escape') { event.preventDefault(); close(true); }
      else if (event.key === 'Tab') close();
    });

    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && isOpen()) close(true); });
    document.addEventListener('pointerdown', (event) => { if (isOpen() && !root.contains(event.target as Node)) close(); });
  });
</script>
