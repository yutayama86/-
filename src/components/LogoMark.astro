---
/**
 * LogoMark — ロゴ プロトタイプ（Blueprint §4）。
 * Codex判断：A案は比較用、主案は B案「FIELD NOTE」の3バリエーション。
 *   B1: 最も簡潔な一本線
 *   B2: 紙の折り目を強調
 *   B3: 歩いた軌跡を強調
 * 一本の連続線が「ページの折り目」と「道筋」を描き、終点は点ではなく短い横線
 * （＝記録が続く）。モノクロ・currentColor・16pxで成立。
 *
 * ⚠️ 未確定：正式ロゴは Codex レビュー後に確定。現行UIに未接続（preview のみ）。
 */
type Variant = 'A' | 'B1' | 'B2' | 'B3';
interface Props {
  variant?: Variant;
  size?: number;
  label?: string;
  class?: string;
}
const { variant = 'B1', size = 40, label, class: className } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

<svg
  class:list={['logomark', `is-${variant.toLowerCase()}`, className]}
  width={size} height={size} viewBox="0 0 40 40"
  fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"
  {...a11y}
>
  {variant === 'A' && (
    <>
      {/* A案 EDITOR'S MARK（比較用）：向かい合う不完全な角括弧＋中央余白 */}
      <path d="M12 12 V22" />
      <path d="M16 12 H24" />
      <path d="M28 28 V18" />
      <path d="M24 28 H16" />
    </>
  )}
  {variant === 'B1' && (
    /* B1：最も簡潔な一本線。ゆるやかに上る道筋＋短い横線で終える */
    <path d="M8 28 C 15 27, 19 20, 22 14 L 32 14" />
  )}
  {variant === 'B2' && (
    <>
      {/* B2：紙の折り目を強調。線が鋭く折れ、めくれた角を短い線で示す＋横線で終える */}
      <path d="M8 27 L 21 14 L 32 14" />
      <path d="M21 14 L 26 19" />
    </>
  )}
  {variant === 'B3' && (
    /* B3：歩いた軌跡を強調。うねる道筋＋短い横線で終える */
    <path d="M7 27 C 12 20, 16 30, 20 24 C 23 19, 26 15, 29 16 L 34 16" />
  )}
</svg>

<style>
  .logomark { display: inline-block; vertical-align: middle; color: var(--color-ink); }
</style>
