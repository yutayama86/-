---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_CONFIG } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  hero?: boolean; // trueなら本文をヘッダー背後まで引き上げる
}

const { hero = false, ...seo } = Astro.props;

// Google Analytics 4 / Search Console（環境変数で設定。ビルド時にインライン化）
//   PUBLIC_GA_ID           … GA4 測定ID（例: G-XXXXXXXXXX）
//   PUBLIC_GSC_VERIFICATION … Search Console のHTMLメタタグ確認コード
// GA4 は「本番ビルド かつ 測定ID設定あり」のときだけ読み込む（開発では無効）。
const GA_ID = import.meta.env.PUBLIC_GA_ID as string | undefined;
const GSC_VERIFICATION = import.meta.env.PUBLIC_GSC_VERIFICATION as string | undefined;
const enableGA = import.meta.env.PROD && !!GA_ID;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f5f1e8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_CONFIG.name} href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap"
      rel="stylesheet"
    />

    <SEO {...seo} />

    {/* Google Search Console 所有権確認（env: PUBLIC_GSC_VERIFICATION） */}
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

    {/* Google Analytics 4（本番のみ・env: PUBLIC_GA_ID）。async読込でSEO/表示速度に影響なし */}
    {enableGA && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_ID}');`}></script>
      </>
    )}
  </head>
  <body>
    <a href="#main" class="sr-only">本文へスキップ</a>
    <Header />
    <main id="main" class={hero ? 'is-hero' : ''}>
      <slot />
    </main>
    <Footer />

    {
      SITE_CONFIG.cfAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${SITE_CONFIG.cfAnalyticsToken}"}`}
        />
      )
    }

    <script>
      // Scroll reveal
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el, i) => {
        (el as HTMLElement).style.setProperty('--delay', `${(i % 4) * 70}ms`);
        io.observe(el);
      });
    </script>
  </body>
</html>

<style>
  main.is-hero { margin-top: -74px; }
</style>
