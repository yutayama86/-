---
import '../styles/global.css';
import { site, analytics } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  /** 記事ページの公開・更新日時（og:article 用）。 */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** 記事ごとに固有のOGP画像がある場合のパス。 */
  image?: string;
  /** 検索結果から除外したいページ（サンクスページなど）。 */
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  canonical = new URL(Astro.url.pathname, site.url).href,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  image,
  noindex = false,
} = Astro.props;

/* OGP画像は絶対URLで指定する必要がある。
   版下は tools/og-image.html、再生成は `npm run og`。 */
const ogImage = new URL(image ?? '/og.png', site.url).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f6f9fc" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="シクミベース｜仕組みで、事業を強くする。中小企業・地域企業の仕組み化支援" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {/* JSが有効なときだけスクロール表示の初期状態を適用する（JS無効でも本文が読める） */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {/*
      計測の共通口。GA4が読み込めない・例外を投げる場合も呼び出し側を止めない。
      個人情報を送らないため、値は固定の属性値・パスだけを使い、メールアドレスや電話番号らしき文字列は伏せる。
    */}
    <script is:inline>
      window.shikumiAnalytics = (() => {
        const SENSITIVE = /[^\s@<>()]+@[^\s@<>()]+\.[^\s@<>()]+|\+?\d[\d\s()-]{8,}\d/g;
        const clean = (value, max = 100) =>
          String(value ?? '').replace(SENSITIVE, '[redacted]').replace(/\s+/g, ' ').trim().slice(0, max);

        const track = (name, params = {}, options = {}) => {
          try {
            if (typeof window.gtag !== 'function') return false;
            const payload = { page_path: location.pathname };
            for (const [key, value] of Object.entries(params)) {
              payload[key] = typeof value === 'number' ? value : clean(value);
            }
            window.gtag('event', name, { ...payload, ...options });
            return true;
          } catch {
            return false;
          }
        };

        return { track, clean };
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <slot />

    <script is:inline>
      (() => {
        const targets = document.querySelectorAll('.reveal');
        if (!targets.length) return;

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );

        targets.forEach((el) => io.observe(el));
      })();
    </script>

    <script is:inline>
      /* CTAのクリックを計測する。data-cta の値で設置場所を区別し、
         どの導線が問い合わせにつながったかを追えるようにする。 */
      (() => {
        let lastTarget = null;
        let lastAt = 0;

        // 遷移先はパスだけを送る。mailto: の本文やクエリに入力内容が載ることがあるため。
        const destinationOf = (href) => {
          if (!href) return '';
          try {
            const url = new URL(href, location.href);
            // Cloudflareのメールアドレス難読化で mailto: が書き換えられた場合も同じ値にそろえる
            if (url.protocol === 'mailto:' || url.pathname.startsWith('/cdn-cgi/l/email-protection')) return 'mailto';
            if (url.protocol === 'tel:') return 'tel';
            return url.origin === location.origin ? url.pathname : `${url.origin}${url.pathname}`;
          } catch {
            return '';
          }
        };

        document.addEventListener('click', (event) => {
          const target = event.target instanceof Element ? event.target.closest('[data-cta]') : null;
          if (!target || !window.shikumiAnalytics) return;

          // ダブルクリックや連打を1回に数える
          const now = Date.now();
          if (target === lastTarget && now - lastAt < 1000) return;
          lastTarget = target;
          lastAt = now;

          window.shikumiAnalytics.track(
            'cta_click',
            {
              source_path: location.pathname,
              destination: destinationOf(target.getAttribute('href')),
              cta_label: target.dataset.ctaLabel || target.textContent.replace(/[→←]/g, ''),
              cta_location: target.dataset.cta,
              cta_topic: target.dataset.ctaTopic || '',
            },
            { transport_type: 'beacon' }
          );
        });
      })();
    </script>

    {/*
      Cloudflare Web Analytics。トークン未設定のときは何も出力しない。
      Cookieを使わないため同意バナーは不要。defer で描画を妨げない。
    */}
    {analytics.cloudflareToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analytics.cloudflareToken })}
      />
    )}

    {/*
      Google Analytics 4。測定ID未設定のときは何も出力しない。
      body末尾に async で置き、初期表示を妨げないようにする。
    */}
    {analytics.ga4MeasurementId && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4MeasurementId}`}
        />
        {/*
          define:vars を使うとAstroがスクリプトをIIFEで包むため、
          gtag をグローバルに出すには window へ明示的に代入する必要がある。
          （今後カスタムイベントを送るときに window.gtag が必要になる）
        */}
        <script is:inline define:vars={{ gaId: analytics.ga4MeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          window.gtag('js', new Date());
          window.gtag('config', gaId);
        </script>
      </>
    )}
  </body>
</html>
