---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import IntlHeader from '../components/IntlHeader.astro';
import IntlFooter from '../components/IntlFooter.astro';
import { SITE_CONFIG } from '../data/site';
import { DEFAULT_LOCALE, LOCALE_META, alternatesFor, xDefaultFor, type Locale } from '../data/i18n';
interface Props { title?: string; ogTitle?: string; description?: string; image?: string; imageAlt?: string; type?: 'website'|'article'; publishedAt?: Date; updatedAt?: Date; jsonLd?: Record<string, unknown>|Record<string, unknown>[]; noindex?: boolean; locale?: Locale; translationKey?: string; }
const {
  title = 'イバトコ｜現地から、信頼を編む。',
  ogTitle,
  description = '編集部とローカルエディターが現地を歩き、人と営みを取材する茨城の地域価値編集ブランド。',
  image,
  imageAlt,
  type = 'website',
  publishedAt,
  updatedAt,
  jsonLd,
  noindex = false,
  locale = DEFAULT_LOCALE,
  translationKey,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 多言語：実在する翻訳だけを相互参照する（存在しないURLは出さない）。
const localeMeta = LOCALE_META[locale];
const alternates = alternatesFor(translationKey);
const xDefault = xDefaultFor(translationKey);
const isIntl = locale !== DEFAULT_LOCALE;
const absolute = (path: string) => new URL(path, Astro.site).href;
const SKIP_LABEL: Record<Locale, string> = { ja: '本文へスキップ', en: 'Skip to content', 'zh-tw': '跳至主要內容', ko: '본문으로 건너뛰기' };
const absoluteImage = new URL(image ?? '/og-default.svg', Astro.site).href;
const GA_ID = (import.meta.env.PUBLIC_GA_ID as string | undefined) || SITE_CONFIG.gaMeasurementId;
const enableGA = import.meta.env.PROD && !!GA_ID;
---
<!doctype html>
<html lang={localeMeta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f2e9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* 検索結果には出さないが、そこから先の記事はたどらせる（タグ・空の一覧などのリンクハブを殺さない） */}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={absolute(alt.path)} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={absolute(xDefault)} />}
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={localeMeta.ogLocale} />
    {alternates.filter((alt) => alt.locale !== locale).map((alt) => <meta property="og:locale:alternate" content={LOCALE_META[alt.locale].ogLocale} />)}
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="イバトコ" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {enableGA && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_ID}');`}></script>
      </>
    )}
  </head>
  <body class="brand-site">
    <a href="#main-content" class="sr-only">{SKIP_LABEL[locale]}</a>
    {isIntl ? <IntlHeader locale={locale} translationKey={translationKey} /> : <SiteHeader translationKey={translationKey} />}
    <main id="main-content"><slot /></main>
    {isIntl ? <IntlFooter locale={locale} /> : <SiteFooter />}
  </body>
</html>

<style is:global>
  .brand-site{margin:0;overflow-x:clip;background:var(--color-paper);color:var(--color-charcoal);font-family:var(--font-brand-body)}
  .bp-wrap{width:min(calc(100% - 2rem),var(--content-wide));margin-inline:auto}
  .bp-reading{width:min(calc(100% - 2rem),var(--content-reading));margin-inline:auto}
  .bp-section{padding-block:clamp(4rem,9vw,7.5rem)}
  .bp-kicker{font:500 .72rem/1 var(--font-brand-meta);letter-spacing:.16em;text-transform:uppercase;color:var(--color-tide)}
  .bp-title{font-family:var(--font-brand-display);color:var(--color-ink);font-size:clamp(2rem,5vw,4.7rem);line-height:1.18;font-weight:600;letter-spacing:.01em}
  .bp-section-title{font-family:var(--font-brand-display);color:var(--color-ink);font-size:clamp(1.7rem,3.2vw,3rem);line-height:1.3}
  .bp-link{color:var(--color-ink);border-bottom:1px solid var(--color-tide);padding-bottom:.15rem}
  .brand-site :focus-visible{outline-color:var(--color-tide)}
  .brand-site ::selection{background:var(--color-tide);color:var(--color-white)}
  .brand-site .eyebrow{color:var(--color-tide)}
  .brand-site .prose h2{border-left-color:var(--color-tide)}
  .brand-site .prose a{color:var(--color-tide)}
  .brand-site .prose ul li::before{background:var(--color-tide)}
  @media(max-width:480px){.bp-wrap,.bp-reading{width:min(calc(100% - 1.5rem),var(--content-wide))}.bp-section{padding-block:3.5rem}}
</style>
