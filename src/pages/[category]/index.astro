---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { CATEGORY_LIST, CATEGORIES } from '../../data/site';
import { getArticlesByCategory } from '../../lib/content';
import type { CategoryKey } from '../../content.config';

export const getStaticPaths = (() => {
  return CATEGORY_LIST.map((c) => ({ params: { category: c.path } }));
}) satisfies GetStaticPaths;

const { category } = Astro.params;
const cat = CATEGORIES[category as CategoryKey];
if (!cat) return Astro.redirect('/404');

const articles = await getArticlesByCategory(category!);
const [lead, ...rest] = articles;
---

<Base
  title={`${cat.label}｜茨城の${cat.label}体験レポート`}
  description={`茨城の${cat.label}を、編集部が実際に体験してレポート。行った人だからわかるリアルな情報だけをお届けします。`}
>
  <section class="cat-hero" style={`--_a:${cat.accent}`}>
    <div class="wrap cat-hero-inner">
      <p class="eyebrow" data-reveal>Genre / {cat.reading}</p>
      <h1 class="display cat-hero-title" data-reveal>{cat.label}</h1>
      <p class="cat-hero-lead mincho" data-reveal>
        茨城の「{cat.label}」を、行った人の目線で。
      </p>
      <nav class="cat-tabs" aria-label="ジャンル切替" data-reveal>
        {CATEGORY_LIST.map((c) => (
          <a href={`/${c.path}/`} class={`cat-tab ${c.key === category ? 'is-active' : ''}`} style={`--_a:${c.accent}`}>{c.label}</a>
        ))}
      </nav>
    </div>
  </section>

  <section class="wrap section">
    {articles.length === 0 ? (
      <p class="empty mincho muted">この「{cat.label}」は、いま取材の真っ最中。<br />最初のレポートをお楽しみに。</p>
    ) : (
      <>
        {lead && (
          <div class="cat-lead" data-reveal>
            <ArticleCard article={lead} size="lg" />
          </div>
        )}
        <div class="cat-grid">
          {rest.map((a, i) => <ArticleCard article={a} index={i} />)}
        </div>
      </>
    )}
  </section>
</Base>

<style>
  .cat-hero { padding: clamp(3rem, 8vw, 6rem) 0 2rem; border-bottom: 1px solid var(--line); position: relative; }
  .cat-hero::before {
    content: ""; position: absolute; inset: 0; z-index: -1; opacity: 0.5;
    background: radial-gradient(60% 100% at 100% 0%, color-mix(in srgb, var(--_a) 20%, transparent), transparent 65%);
  }
  .cat-hero-title { font-size: var(--step-5); color: var(--ink); }
  .cat-hero-lead { font-size: var(--step-1); color: var(--ink-soft); margin-top: 0.6rem; }
  .cat-tabs { display: flex; gap: 0.6rem; margin-top: 2.5rem; flex-wrap: wrap; }
  .cat-tab {
    padding: 0.5em 1.2em; border: 1px solid var(--line-strong); border-radius: 999px;
    font-size: var(--step--1); font-weight: 700; color: var(--ink-soft); transition: all 0.3s;
  }
  .cat-tab:hover { border-color: var(--_a); color: var(--_a); }
  .cat-tab.is-active { background: var(--_a); color: #fff; border-color: var(--_a); }

  .section { padding-block: clamp(3rem, 7vw, 5rem); }
  .cat-lead { margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 2.5rem); }
  .empty { font-size: var(--step-1); text-align: center; padding-block: 3rem; }
  @media (max-width: 1000px) { .cat-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .cat-grid { grid-template-columns: 1fr; } }
</style>
