---
import type { GetStaticPaths } from 'astro';
import BrandBase from '../../layouts/BrandBase.astro';
import Breadcrumbs, { type Crumb } from '../../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import BrandStoryCard from '../../components/BrandStoryCard.astro';
import { CATEGORY_LIST, CATEGORIES } from '../../data/site';
import { getArticlesByCategory } from '../../lib/content';
import type { CategoryKey } from '../../content.config';
export const getStaticPaths = (() => CATEGORY_LIST.map((item) => ({ params: { category: item.path } }))) satisfies GetStaticPaths;
const { category } = Astro.params; const cat = CATEGORIES[category as CategoryKey]; if (!cat) return Astro.redirect('/404');
const articles = await getArticlesByCategory(category!);
const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: cat.label }];
---
<BrandBase title={`${cat.label}｜茨城の物語｜イバトコ`} description={`茨城の「${cat.label}」を、現地で確かめた情報から届けます。`} noindex={articles.length === 0} jsonLd={breadcrumbJsonLd(crumbs, Astro.site)}>
  <header class="category-head bp-wrap"><Breadcrumbs items={crumbs} /><p class="bp-kicker">THEME / {cat.reading}</p><h1>{cat.label}</h1><p>茨城で見つけた「{cat.label}」を、人と営みの背景から。</p><nav aria-label="テーマ切替">{CATEGORY_LIST.map((item) => <a href={`/${item.path}/`} aria-current={item.path===category?'page':undefined}>{item.label}</a>)}</nav></header>
  {articles.length > 0 ? <section class="category-grid bp-wrap">{articles.map((article) => <BrandStoryCard article={article} />)}</section> : <section class="category-empty bp-reading"><p class="bp-kicker">FIELD NOTE</p><h2>確かめ終えたものから、公開します。</h2><p>架空の記事や写真で数を埋めず、現地確認と掲載許諾が終わった記事から届けます。</p><a href="/about/editorial-policy/">編集方針を読む →</a></section>}
</BrandBase>
<style>
  .category-head{padding-block:clamp(5rem,11vw,9rem);border-bottom:1px solid var(--color-mist)}.category-head h1{margin-top:1rem;font:600 clamp(3.5rem,11vw,9rem)/1 var(--font-brand-display);color:var(--color-ink)}.category-head>p:not(.bp-kicker){margin-top:1.5rem;color:var(--color-soil);font:500 1.1rem/1.9 var(--font-brand-display)}.category-head nav{display:flex;flex-wrap:wrap;gap:.6rem 1.2rem;margin-top:2.5rem}.category-head nav a{padding-bottom:.2rem;color:var(--color-soil);border-bottom:1px solid var(--color-mist);font-size:.85rem}/* 選択中の色は interior.css のピル表示（濃紺の地）に合わせる。
   tide のままだと濃紺の上に濃い文字が乗って読めない。 */
.category-head nav a[aria-current="page"]{color:#fff;background:var(--interior-blue,#174f99);border-color:var(--interior-blue,#174f99)}
  .category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;padding-block:clamp(4rem,9vw,7rem)}.category-empty{padding-block:clamp(5rem,11vw,9rem)}.category-empty h2{margin-top:1rem;font:600 clamp(2rem,5vw,4rem)/1.3 var(--font-brand-display);color:var(--color-ink)}.category-empty>p:not(.bp-kicker){margin-top:1.5rem;color:var(--color-soil)}.category-empty a{display:inline-block;margin-top:2rem;color:var(--color-tide);border-bottom:1px solid}
  @media(max-width:850px){.category-grid{grid-template-columns:1fr}}
</style>
