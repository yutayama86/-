---
import { getCollection } from 'astro:content';
import BrandBase from '../layouts/BrandBase.astro';
import EditorialProcess from '../components/EditorialProcess.astro';
import { SITE_CONFIG } from '../data/site';
import { MUNICIPALITIES } from '../data/areas';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../lib/seo';

const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: 'イバトコについて' }];

/**
 * ページに出す数字は、記事から毎回数え直す。
 * 手で書くと、記事が増えたときに古い数字が残る。
 * 「出典のない記事は0本」は編集方針そのものなので、実際に数えて出す。
 */
const news = (await getCollection('news')).filter((e) => !e.data.draft && !e.data.noindex);
const events = (await getCollection('events')).filter((e) => !e.data.draft && !e.data.noindex);
const published = [...news, ...events];
const sourceCount = published.reduce((n, e) => n + (e.data.sourceUrls?.length ?? 0), 0);
const withoutSource = published.filter((e) => (e.data.sourceUrls?.length ?? 0) === 0).length;
const lastUpdated = published
  .map((e) => e.data.updatedDate ?? e.data.pubDate)
  .sort((a, b) => b.valueOf() - a.valueOf())[0];
const fmt = (d: Date) => new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);

const figures = [
  { value: MUNICIPALITIES.length, unit: '市町村', label: '茨城県の全市町村を対象にしています' },
  { value: published.length, unit: '本', label: '公開している記事' },
  { value: sourceCount, unit: '件', label: '記事に添えた一次情報へのリンク' },
  { value: withoutSource, unit: '本', label: '出典を示していない記事', accent: true },
];

const policies = [
  { href: '/about/editorial-policy/', title: '編集方針', desc: '取材・編集・AI利用', detail: '誰が、いつ、どう確かめたか。書く前と後に何をするかを決めています。' },
  { href: '/about/pr-policy/', title: 'PR・広告の方針', desc: 'Editorial / Partner / PR', detail: 'お金や便宜が動いたときは、記事のどこに何を書くかを決めています。' },
  { href: '/about/corrections/', title: '訂正・更新方針', desc: '確認・判断・履歴公開', detail: '間違えたときに、消さずに直した記録を残します。' },
  { href: '/about/team/', title: '運営・チーム', desc: '公開責任と編集体制', detail: '誰が責任を持って出しているかを明らかにします。' },
];
---

<BrandBase title="イバトコについて｜現地から、信頼を編む。" description="イバトコは、茨城で続く人の仕事と営みを現地で取材し、確かめられる形で記録します。全記事に一次情報の出典を添えています。" jsonLd={breadcrumbJsonLd(crumbs, Astro.site)}>
  {/*
    見出しの組みは下層ページ共通（780pxの読みカラム）に合わせる。
    ここだけ2カラムにすると、他のページと h1 の左端が揃わない。
    奥付は見出しの下に横帯として置き、同じカラムに乗せる。
  */}
  <header class="about-head bp-wrap">
    <Breadcrumbs items={crumbs} />
    <p class="bp-kicker">ABOUT IBATOCO</p>
    <h1>茨城で続く営みを、<br />きちんと残す。</h1>
    <p class="ab-hero__lead">イバトコは、茨城で暮らし、働く人に会い、その言葉と仕事を記録します。店や場所の情報だけでなく、なぜここで続けているのかまで聞き、あとから確かめられる形で届けます。</p>
    {/* 発行元を明示した奥付。ブログではなく媒体であることを、最初の画面で示す */}
    <dl class="ab-masthead" aria-label="発行の情報">
      <div><dt>発行</dt><dd>{SITE_CONFIG.name}編集部</dd></div>
      <div><dt>対象</dt><dd>茨城県 全{MUNICIPALITIES.length}市町村</dd></div>
      {lastUpdated && <div><dt>最終更新</dt><dd><time datetime={lastUpdated.toISOString()}>{fmt(lastUpdated)}</time></dd></div>}
    </dl>
  </header>

  {/*
    このページに図版が1枚も無く、読むものだけが続いていた。
    写真は許諾の確認できないものを使わない方針なので、代わりに
    サイト自身の数字を出す。すべてビルド時に記事から数え直す。
  */}
  <section class="ab-figures" aria-labelledby="ab-figures-title">
    <div class="bp-wrap">
      <p class="bp-kicker">RECORD</p>
      <h2 id="ab-figures-title">数字で見るイバトコ</h2>
      <dl class="ab-figures__grid">
        {figures.map((f) => (
          <div class:list={['ab-figure', { 'is-accent': f.accent }]}>
            <dt><span class="ab-figure__num">{f.value}</span><span class="ab-figure__unit">{f.unit}</span></dt>
            <dd>{f.label}</dd>
          </div>
        ))}
      </dl>
      <p class="ab-figures__note">記事が増えるたびに、この数字も数え直しています。出典は記事の末尾に、確認した日付とあわせて載せています。</p>
    </div>
  </section>

  {/* 姿勢を述べる節。前後と同じ組みだと流れてしまうので、地色を変えた帯にする */}
  <section class="ab-belief">
    <div class="bp-wrap">
      <p class="bp-kicker">OUR BELIEF</p>
      <h2>知らないことは、<br />知らないまま書かない。</h2>
      <p>誰が、いつ、どのように確かめた情報なのかを大切にします。事実と現地での印象を分け、PRは明示し、誤りがあれば直した記録を残します。</p>
    </div>
  </section>

  <section class="bp-wrap bp-section"><EditorialProcess /></section>

  <section class="ab-policies">
    <div class="bp-wrap">
      <p class="bp-kicker">POLICIES</p>
      <h2>編集の約束を、公開しています。</h2>
      <p class="ab-policies__lead">守れているかどうかを、読む側が確かめられるように書いています。</p>
      <ul class="bp-cards">
        {policies.map((p) => (
          <li><a href={p.href}>
            <span class="bp-card__meta"><b>{p.desc}</b></span>
            <strong>{p.title}</strong>
            <small>{p.detail}</small>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="ab-info bp-wrap">
    <div>
      <p class="bp-kicker">CONTACT</p>
      <h2>連絡先</h2>
      <dl>
        <div><dt>名称</dt><dd>{SITE_CONFIG.name}（{SITE_CONFIG.nameEn}）</dd></div>
        <div><dt>対象地域</dt><dd>茨城県</dd></div>
        <div><dt>メール</dt><dd><a href={`mailto:${SITE_CONFIG.contactEmail}`}>{SITE_CONFIG.contactEmail}</a></dd></div>
      </dl>
    </div>
    <div class="ab-info__actions">
      <a href="/contact/">お問い合わせ →</a>
      <a href="/biz/">地域事業者の方へ →</a>
    </div>
  </section>
</BrandBase>

<style>
  /* --- 見出し（このページ共通のスケール） --- */
  .ab-figures h2, .ab-belief h2, .ab-policies h2, .ab-info h2 {
    margin-top: .9rem;
    font: 600 clamp(1.7rem, 2.8vw, 2.45rem)/1.45 var(--font-brand-display);
    color: var(--color-ink);
    text-wrap: balance;
  }

  /* --- Hero：見出しの組みは共通のまま、奥付を横帯で足す --- */
  .about-head h1 { margin-top: 1rem; font: 600 clamp(2.4rem, 5.2vw, 4.4rem)/1.24 var(--font-brand-display); color: var(--color-ink); letter-spacing: .01em; }
  .ab-hero__lead { max-width: var(--measure); margin-top: 1.9rem; font: 500 clamp(1rem, 1.5vw, 1.13rem)/2.05 var(--font-brand-display); color: var(--color-soil); }
  .ab-masthead { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin-top: 2.6rem; background: var(--color-mist); border: 1px solid var(--color-mist); }
  .ab-masthead div { display: grid; gap: .25rem; padding: .9rem 1.05rem 1rem; background: var(--color-white); }
  .ab-masthead dt { color: var(--color-tide); font: 700 .62rem var(--font-brand-meta); letter-spacing: .14em; }
  .ab-masthead dd { margin: 0; font: 600 .92rem/1.55 var(--font-brand-display); color: var(--color-ink); }

  /* --- 数字 --- */
  .ab-figures { padding-block: var(--interior-section-y); border-top: 1px solid var(--color-mist); }
  .ab-figures__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin-top: 2.2rem; background: var(--color-mist); border: 1px solid var(--color-mist); }
  .ab-figure { display: grid; align-content: start; gap: .55rem; padding: 1.6rem 1.4rem 1.8rem; background: var(--color-white); }
  .ab-figure dt { display: flex; align-items: baseline; gap: .3rem; }
  .ab-figure__num { font: 600 clamp(2.4rem, 4vw, 3.4rem)/1 var(--font-brand-display); color: var(--color-deep-blue); font-variant-numeric: tabular-nums; }
  .ab-figure__unit { font: 600 .9rem var(--font-brand-display); color: var(--color-soil); }
  .ab-figure dd { margin: 0; color: var(--color-soil); font-size: .82rem; line-height: 1.8; }
  /* 「出典のない記事は0本」だけは主張なので、色で1つだけ持ち上げる */
  .ab-figure.is-accent .ab-figure__num { color: var(--color-signal); }
  .ab-figure.is-accent dd { color: var(--color-ink); font-weight: 600; }
  .ab-figures__note { max-width: var(--measure); margin-top: 1.5rem; color: var(--color-soil); font-size: .82rem; line-height: 1.9; }

  /* --- Belief：地色を変えた帯にして、節の連続を切る --- */
  .ab-belief { padding-block: clamp(4rem, 8vw, 7rem); background: var(--color-deep-blue); }
  .ab-belief .bp-kicker { color: var(--color-moss); }
  .ab-belief h2 { margin-top: 1rem; font-size: clamp(1.9rem, 3.4vw, 3rem); line-height: 1.5; color: var(--color-white); }
  .ab-belief p { max-width: var(--measure); margin-top: 1.9rem; color: rgba(255, 255, 255, .82); line-height: 2.05; }

  /* --- Policies：共通カードに載せる。以前は罫線だけの一覧で、
         見出しと説明が1440pxの両端に離れていた --- */
  .ab-policies { padding-block: var(--interior-section-y); background: var(--color-white); }
  .ab-policies__lead { max-width: var(--measure); margin-top: .9rem; color: var(--color-soil); font-size: .9rem; line-height: 1.9; }
  .ab-policies .bp-cards { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .ab-policies .bp-card__meta { padding-top: 1.15rem; }

  /* --- Info --- */
  .ab-info { display: grid; grid-template-columns: minmax(0, 1.4fr) auto; gap: clamp(2rem, 5vw, 4rem); padding-block: var(--interior-section-y); align-items: start; }
  .ab-info dl { margin-top: 1.6rem; border-top: 1px solid var(--color-mist); }
  .ab-info dl div { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 1rem; padding-block: .95rem; border-bottom: 1px solid var(--color-mist); }
  .ab-info dt { color: var(--color-soil); font-size: .78rem; }
  .ab-info dd { margin: 0; }
  .ab-info__actions { display: grid; align-content: start; gap: 1rem; padding-top: 3.4rem; }

  @media (max-width: 1000px) {
    .ab-figures__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ab-policies .bp-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 820px) {
    .ab-info { grid-template-columns: 1fr; }
    .ab-info__actions { padding-top: 0; }
  }
  @media (max-width: 560px) {
    .ab-figures__grid, .ab-policies .bp-cards { grid-template-columns: 1fr; }
    .ab-masthead { grid-template-columns: 1fr; }
  }
</style>
