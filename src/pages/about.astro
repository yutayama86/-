---
import BrandBase from '../layouts/BrandBase.astro';
import EditorialProcess from '../components/EditorialProcess.astro';
import { SITE_CONFIG } from '../data/site';
import { MUNICIPALITIES } from '../data/areas';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../lib/seo';

const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: 'イバトコについて' }];

/**
 * 方針は「番号つきの一覧」で見せる。カードにすると、このページは
 * 枠の並びばかりになる（奥付・数字・方針で3回続いていた）。
 */
const policies = [
  { href: '/about/editorial-policy/', title: '編集方針', detail: '誰が、いつ、どう確かめたか。書く前と後にすることを決めています。' },
  { href: '/about/pr-policy/', title: 'PR・広告の方針', detail: 'お金や便宜が動いたときに、記事のどこへ何を書くかを決めています。' },
  { href: '/about/corrections/', title: '訂正・更新方針', detail: '間違えたときは、消さずに直した記録を残します。' },
  { href: '/about/team/', title: '運営・チーム', detail: '誰が責任を持って出しているかを明らかにします。' },
];
---

<BrandBase title="イバトコについて｜現地から、信頼を編む。" description="イバトコは、茨城で続く人の仕事と営みを現地で取材し、確かめられる形で記録します。公開している記事には、すべて一次情報の出典を添えています。" jsonLd={breadcrumbJsonLd(crumbs, Astro.site)}>
  {/* 見出しの組みは下層ページ共通（780pxの読みカラム）。ここだけ2カラムにすると左端が揃わない */}
  <header class="about-head bp-wrap">
    <Breadcrumbs items={crumbs} />
    <p class="bp-kicker">ABOUT IBATOCO</p>
    <h1>茨城で続く営みを、<br />きちんと残す。</h1>
    <p class="ab-lead">イバトコは、茨城で暮らし、働く人に会い、その言葉と仕事を記録します。店や場所の情報だけでなく、なぜここで続けているのかまで聞き、あとから確かめられる形で届けます。</p>
    {/* 発行元は、枠で囲まず1行で置く */}
    <p class="ab-byline">発行：{SITE_CONFIG.name}編集部<span>／</span>対象：茨城県 全{MUNICIPALITIES.length}市町村</p>
  </header>

  {/*
    このページで唯一の強い一打。地色を変えるだけでなく、
    一文に大きさを与えて、ここだけ景色が変わるようにする。
  */}
  <section class="ab-belief">
    <div class="bp-wrap">
      <p class="bp-kicker">OUR BELIEF</p>
      <h2>知らないことは、<br />知らないまま書かない。</h2>
      <div class="ab-belief__body">
        <p>誰が、いつ、どのように確かめた情報なのかを大切にします。事実と現地での印象を分け、PRは明示し、誤りがあれば直した記録を残します。</p>
        <p class="ab-belief__pledge">公開している記事には、すべて一次情報の出典を、確認した日付とあわせて添えています。</p>
      </div>
    </div>
  </section>

  <section class="bp-wrap bp-section"><EditorialProcess /></section>

  {/* 方針は番号つきの一覧。前後と形を変えて、枠の連続にしない */}
  <section class="ab-policies">
    <div class="bp-wrap">
      <p class="bp-kicker">POLICIES</p>
      <h2>編集の約束を、公開しています。</h2>
      <p class="ab-policies__lead">守れているかどうかを、読む側が確かめられるように書いています。</p>
      <ol class="ab-policy-list">
        {policies.map((p, i) => (
          <li>
            <a href={p.href}>
              <b aria-hidden="true">{String(i + 1).padStart(2, '0')}</b>
              <span class="ab-policy-list__body">
                <strong>{p.title}</strong>
                <span>{p.detail}</span>
              </span>
              <em aria-hidden="true">→</em>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="ab-close bp-wrap">
    <p class="bp-kicker">CONTACT</p>
    <h2>この記録について、話しませんか。</h2>
    <p class="ab-close__lead">取材のご相談、掲載内容のご指摘、地域事業者の方からのお問い合わせをお待ちしています。</p>
    <p class="ab-close__mail"><a href={`mailto:${SITE_CONFIG.contactEmail}`}>{SITE_CONFIG.contactEmail}</a></p>
    <div class="ab-close__actions">
      <a href="/contact/">お問い合わせ →</a>
      <a href="/biz/">地域事業者の方へ →</a>
    </div>
  </section>
</BrandBase>

<style>
  /* --- 見出しのスケール（このページ共通） --- */
  .ab-policies h2, .ab-close h2 {
    margin-top: .9rem;
    font: 600 clamp(1.7rem, 2.8vw, 2.45rem)/1.45 var(--font-brand-display);
    color: var(--color-ink);
    text-wrap: balance;
  }

  /* --- 見出し：最初の画面は文字だけで持たせる --- */
  .about-head h1 { margin-top: 1rem; font: 600 clamp(2.5rem, 5.6vw, 4.6rem)/1.24 var(--font-brand-display); color: var(--color-ink); letter-spacing: .01em; }
  .ab-lead { max-width: var(--measure); margin-top: 2rem; font: 500 clamp(1rem, 1.5vw, 1.15rem)/2.05 var(--font-brand-display); color: var(--color-soil); }
  .ab-byline { margin-top: 2.2rem; color: var(--color-soil); font: .78rem/1.9 var(--font-brand-meta); letter-spacing: .04em; }
  .ab-byline span { margin-inline: .55rem; color: var(--color-mist); }

  /* --- BELIEF：ページ唯一の強い面。一文に大きさを与える --- */
  .ab-belief { padding-block: clamp(5rem, 10vw, 9rem); background: var(--color-deep-blue); }
  .ab-belief .bp-kicker { color: var(--color-moss); }
  .ab-belief h2 { margin-top: 1.4rem; font: 600 clamp(2.1rem, 4.4vw, 3.9rem)/1.42 var(--font-brand-display); color: var(--color-white); letter-spacing: .01em; }
  .ab-belief__body { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: clamp(1.6rem, 3vw, 3rem); margin-top: clamp(2.4rem, 4vw, 3.4rem); padding-top: clamp(2rem, 3vw, 2.8rem); border-top: 1px solid rgba(255, 255, 255, .22); }
  .ab-belief__body p { color: rgba(255, 255, 255, .8); line-height: 2.05; font-size: .95rem; }
  .ab-belief__pledge { color: var(--color-white); font-weight: 600; }

  /* --- POLICIES：番号つきの一覧。カードにすると枠の連続になる --- */
  .ab-policies { padding-block: var(--interior-section-y); background: var(--color-white); }
  .ab-policies__lead { max-width: var(--measure); margin-top: .9rem; color: var(--color-soil); font-size: .9rem; line-height: 1.9; }
  .ab-policy-list { margin-top: 2.6rem; padding: 0; list-style: none; border-top: 1px solid var(--color-mist); }
  .ab-policy-list li { border-bottom: 1px solid var(--color-mist); }
  .ab-policy-list a { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr) 1.5rem; align-items: baseline; gap: 0 clamp(1rem, 2.5vw, 2.2rem); padding-block: clamp(1.3rem, 2.2vw, 1.8rem); color: var(--color-ink); transition: background-color .2s ease; }
  .ab-policy-list b { font: 600 .95rem var(--font-brand-meta); color: var(--color-tide); font-variant-numeric: tabular-nums; }
  .ab-policy-list__body { display: grid; gap: .45rem; min-width: 0; }
  .ab-policy-list strong { font: 600 clamp(1.15rem, 1.9vw, 1.5rem)/1.5 var(--font-brand-display); color: var(--color-deep-blue); }
  .ab-policy-list__body > span { max-width: var(--measure); color: var(--color-soil); font-size: .87rem; line-height: 1.85; }
  .ab-policy-list em { font-style: normal; color: var(--color-tide); transition: transform .2s ease; }
  .ab-policy-list a:hover, .ab-policy-list a:focus-visible { background: rgba(237, 246, 255, .55); }
  .ab-policy-list a:hover em { transform: translateX(.3rem); }

  /* --- 締め：表ではなく、呼びかけの一段 --- */
  .ab-close { padding-block: var(--interior-section-y); }
  .ab-close__lead { max-width: var(--measure); margin-top: 1rem; color: var(--color-soil); line-height: 1.95; }
  .ab-close__mail { margin-top: 1.8rem; font: 600 clamp(1.2rem, 2.4vw, 1.85rem) var(--font-brand-display); }
  .ab-close__mail a { color: var(--color-tide); border-bottom: 1px solid currentColor; padding-bottom: .1rem; }
  .ab-close__actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.4rem; }
  .ab-close__actions a { display: inline-flex; align-items: center; min-height: 3rem; padding: .7rem 1.3rem; border: 1px solid rgba(31, 99, 191, .28); border-radius: 999px; color: var(--interior-blue); font-size: .9rem; font-weight: 600; }

  @media (max-width: 560px) {
    .ab-policy-list a { grid-template-columns: 2.4rem minmax(0, 1fr); }
    .ab-policy-list em { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ab-policy-list a, .ab-policy-list em { transition: none; }
    .ab-policy-list a:hover em { transform: none; }
  }
</style>
