---
import BrandBase from '../layouts/BrandBase.astro'; import EditorialProcess from '../components/EditorialProcess.astro'; import { SITE_CONFIG } from '../data/site';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../lib/seo';
const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: 'イバトコについて' }];
---
<BrandBase title="イバトコについて｜現地から、信頼を編む。" description="イバトコは、茨城で続く人の仕事と営みを現地で取材し、確かめられる形で記録します。" jsonLd={breadcrumbJsonLd(crumbs, Astro.site)}>
  <header class="about-head bp-wrap"><Breadcrumbs items={crumbs} /><p class="bp-kicker">ABOUT IBATOCO</p><h1>茨城で続く営みを、<br />きちんと残す。</h1><p>イバトコは、茨城で暮らし、働く人に会い、その言葉と仕事を記録します。店や場所の情報だけでなく、なぜここで続けているのかまで聞き、あとから確かめられる形で届けます。</p></header>
  <section class="belief bp-wrap"><p class="bp-kicker">OUR BELIEF</p><div><h2>知らないことは、<br />知らないまま書かない。</h2><p>誰が、いつ、どのように確かめた情報なのかを大切にします。事実と現地での印象を分け、PRは明示し、誤りがあれば直した記録を残します。</p></div></section>
  <section class="bp-wrap bp-section"><EditorialProcess /></section>
  <section class="policies"><div class="bp-wrap"><p class="bp-kicker">POLICIES</p><h2>編集の約束を、公開しています。</h2><nav><a href="/about/editorial-policy/"><span>編集方針</span><small>取材・編集・AI利用</small></a><a href="/about/pr-policy/"><span>PR・広告の方針</span><small>Editorial / Partner / PR</small></a><a href="/about/corrections/"><span>訂正・更新方針</span><small>確認・判断・履歴公開</small></a><a href="/about/team/"><span>運営・チーム</span><small>公開責任と編集体制</small></a></nav></div></section>
  <section class="about-info bp-wrap"><dl><div><dt>名称</dt><dd>{SITE_CONFIG.name}（{SITE_CONFIG.nameEn}）</dd></div><div><dt>対象地域</dt><dd>茨城県</dd></div><div><dt>連絡先</dt><dd><a href={`mailto:${SITE_CONFIG.contactEmail}`}>{SITE_CONFIG.contactEmail}</a></dd></div></dl><div><a href="/contact/">お問い合わせ →</a><a href="/biz/">地域事業者の方へ →</a></div></section>
</BrandBase>
<style>
  .about-head{padding-block:clamp(5rem,11vw,10rem);border-bottom:1px solid var(--color-mist)}.about-head h1{margin-top:1rem;font:600 clamp(2.7rem,7vw,6rem)/1.22 var(--font-brand-display);color:var(--color-ink)}.about-head>p:last-child{max-width:48ch;margin-top:2rem;font:500 clamp(1rem,1.7vw,1.2rem)/2 var(--font-brand-display);color:var(--color-soil)}
  /* 左に幅300pxの空カラムを置く2カラムだったが、キッカーしか入らず空白が広いだけだった。
     サイト共通の「キッカーを見出しの上に置く」1カラムへ揃える。 */
  .belief{display:block}.belief h2{margin-top:.9rem;font:600 clamp(1.9rem,3vw,2.85rem)/1.5 var(--font-brand-display);color:var(--color-ink);text-wrap:balance}.belief div>p{max-width:54ch;margin-top:2rem;line-height:2;color:var(--color-soil)}
  .policies{padding-block:clamp(4rem,9vw,7rem);background:var(--color-white)}.policies h2{margin-top:1rem;font:600 clamp(2rem,4vw,3.5rem) var(--font-brand-display);color:var(--color-ink)}.policies nav{margin-top:2.5rem;border-top:1px solid var(--color-mist)}.policies a{display:flex;justify-content:space-between;gap:2rem;padding-block:1.3rem;border-bottom:1px solid var(--color-mist)}.policies span{font:600 1.2rem var(--font-brand-display);color:var(--color-ink)}.policies small{color:var(--color-soil)}
  .about-info{display:grid;grid-template-columns:1fr auto;gap:3rem;padding-block:clamp(4rem,8vw,6rem)}.about-info dl{border-top:1px solid var(--color-mist)}.about-info dl div{display:grid;grid-template-columns:8rem 1fr;gap:1rem;padding-block:1rem;border-bottom:1px solid var(--color-mist)}.about-info dt{color:var(--color-soil);font-size:.78rem}.about-info>div{display:grid;align-content:start;gap:1rem}/* ボタンの形は interior.css がピル型で描く。下線リンクだった頃の
     color / border-bottom は特異度でそれに勝ち、下辺だけ色が違っていたので外した。 */
  @media(max-width:700px){.belief,.about-info{grid-template-columns:1fr}.policies a{display:grid;gap:.4rem}}
  @media(max-width:480px){.about-head h1{font-size:2.1rem;line-height:1.35}}
  @media(max-width:360px){.about-head h1{font-size:1.8rem;line-height:1.4}}
</style>
