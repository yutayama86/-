---
import Base from '../layouts/Base.astro';

const services = [
  { icon: '🎬', title: 'SNS運用代行', body: '取材でまとめ撮りした素材を活用。Instagramリール・TikTok・X・Threadsを、追加撮影コストなしで運用します。' },
  { icon: '💻', title: 'ホームページ制作', body: '“売れる”設計のコーポレート／店舗サイト。制作から公開、その後の保守運用までワンストップ。' },
  { icon: '📅', title: '予約システム導入', body: '自社予約フォーム・決済連携。電話対応の手間を減らし、機会損失を防ぎます。' },
  { icon: '🗂', title: '顧客データ（CRM）', body: '予約・来店・リピートのデータを一元管理。次の一手が“数字で”見えるようになります。' },
  { icon: '📸', title: '取材・撮影', body: 'プロによる縦型動画・写真撮影。人の熱量が伝わる、AIには作れないコンテンツを。' },
  { icon: '📈', title: '集客コンサル', body: 'メディア×SNS×WEBを束ねた集客設計。お店の“勝ち筋”を一緒に描きます。' },
];
---

<Base
  title="WEB集客・HP制作・SNS代行サポート"
  description="イバトコのWEB集客サポート。SNS運用代行・ホームページ制作・予約システム・CRMまで、茨城のお店のWEBまわりを丸ごとお預かりします。"
>
  <section class="ag-hero">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Web Support — 集客の、その先へ</p>
      <h1 class="display ag-h1" data-reveal>WEBまわりを、<br />ぜんぶ相棒に。</h1>
      <p class="ag-lead" data-reveal>
        集客が動き出したら、次は“仕組み”です。SNS運用・HP・予約・顧客管理まで。
        イバトコが、茨城のお店のWEB担当として並走します。
      </p>
      <a href="/contact/" class="btn btn--shu btn--lg" data-reveal>相談する（無料） <span class="arw">→</span></a>
    </div>
  </section>

  <section class="wrap section">
    <div class="sec-head" data-reveal><h2>できること<span class="latin num"> / Services</span></h2></div>
    <ul class="svc-grid">
      {services.map((s) => (
        <li class="svc" data-reveal>
          <span class="svc-icon" aria-hidden="true">{s.icon}</span>
          <h3 class="display svc-title">{s.title}</h3>
          <p class="svc-body">{s.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="ag-flow">
    <div class="wrap ag-flow-inner">
      <div data-reveal>
        <p class="eyebrow">Why us</p>
        <h2 class="display ag-flow-title">「集客できるメディア」を<br />持っている強み。</h2>
        <p class="ag-flow-text">
          私たちは、すでに茨城で集客力を持つメディア「イバトコ」の運営者です。
          だから、机上の空論ではなく、<b>実際にお客さんを連れてこられる</b>WEB支援ができます。
          解約したくならない“相棒”を目指します。
        </p>
        <a href="/biz/" class="btn btn--ghost">まずは掲載から見る <span class="arw">→</span></a>
      </div>
      <div class="ag-stat" data-reveal>
        <div class="stat"><span class="stat-num latin">80%+</span><span class="stat-label">想定粗利率</span></div>
        <div class="stat"><span class="stat-num latin">1回</span><span class="stat-label">取材で1ヶ月分の素材</span></div>
        <div class="stat"><span class="stat-num latin">4大</span><span class="stat-label">SNSをまとめて運用</span></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .section { padding-block: clamp(3rem, 7vw, 6rem); }
  .ag-hero { padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(1rem, 3vw, 2rem); background: radial-gradient(80% 100% at 0% 0%, color-mix(in srgb, var(--nemo) 16%, transparent), transparent 60%); }
  .ag-h1 { font-size: var(--step-5); }
  .ag-lead { margin: 1.6rem 0 2.2rem; font-size: var(--step-1); color: var(--ink-soft); line-height: 1.9; max-width: 60ch; }

  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 2.5rem; background: var(--line); border: 1px solid var(--line); }
  .svc { background: var(--paper); padding: clamp(1.6rem, 3vw, 2.4rem); display: grid; gap: 0.7rem; align-content: start; transition: background 0.3s; }
  .svc:hover { background: var(--paper-2); }
  .svc-icon { font-size: 2rem; }
  .svc-title { font-size: var(--step-1); }
  .svc-body { color: var(--ink-soft); font-size: var(--step-0); }

  .ag-flow { background: var(--paper-2); }
  .ag-flow-inner { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 5vw, 4rem); padding-block: clamp(3.5rem, 8vw, 6rem); align-items: center; }
  .ag-flow-title { font-size: var(--step-3); margin: 0.6rem 0 1.2rem; }
  .ag-flow-text { color: var(--ink-soft); font-size: var(--step-1); line-height: 1.9; margin-bottom: 1.8rem; }
  .ag-flow-text b { color: var(--shu-deep); }
  .ag-stat { display: grid; gap: 1rem; }
  .stat { background: var(--ink); color: var(--paper); padding: 1.6rem 1.8rem; border-radius: var(--radius); display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .stat-num { font-size: var(--step-3); color: var(--shu); }
  .stat-label { color: rgba(245,241,232,.75); font-size: var(--step--1); text-align: right; }

  @media (max-width: 860px) { .svc-grid { grid-template-columns: 1fr; } .ag-flow-inner { grid-template-columns: 1fr; } }
</style>
