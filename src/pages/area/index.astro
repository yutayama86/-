---
import BrandBase from '../../layouts/BrandBase.astro';
import HomeAreaExplorer from '../../components/HomeAreaExplorer.astro';
---

<BrandBase title="エリアから探す｜44市町村から茨城を読む｜イバトコ" description="茨城県44市町村を地図から選び、取材・確認を経た地域の記事、場所、人を探せます。">
  <main class="area-index-main">
    <h1 class="sr-only">茨城県44市町村から探す</h1>
    <div class="bp-wrap"><HomeAreaExplorer /></div>
  </main>
</BrandBase>

<style>
  .area-index-main{
    min-height:calc(100svh - 76px);
    padding-block:clamp(3rem,7vw,6.5rem);
    background:color-mix(in srgb,var(--color-sand) 42%,var(--color-paper));
  }
</style>
