---
import Base from '../layouts/Base.astro';

const phases = [
  {
    n: '01',
    tag: '入口・無料',
    title: 'まず、無料で載る。',
    body: '店舗ページ・ディレクトリ・「地名×ジャンル」まとめに無料で掲載。「イバトコを見て来ました」という最初のお客様との出会いから、リスクなく始められます。',
    price: '無料掲載　0円',
    color: 'var(--matcha)',
  },
  {
    n: '02',
    tag: '強化',
    title: '公式店舗で、"選ばれる"ページに。',
    body: '写真・メニュー・クーポンを充実させ、アクセス分析で反応を見る。検索とAI検索から見つけてもらえる、育つ店舗ページへ。オーナーご自身でも編集できます。',
    price: '公式店舗　月額 9,800円',
    color: 'var(--shu)',
  },
  {
    n: '03',
    tag: '集客〜DX',
    title: '集客も、WEBまわりも相棒に。',
    body: '取材記事・モデルコース掲載やSNS／AI検索対策で攻めの集客へ。さらに公式HP・予約・LINE・CRMまで、地域DXパートナーとして丸ごとお預かりします。',
    price: '集客 月額29,800円　〜　地域DX 要相談',
    color: 'var(--gold)',
  },
];

const plans = [
  {
    key: 'free',
    name: '無料掲載',
    price: '¥0',
    unit: '/ 月',
    lead: 'まずは載せる。',
    features: ['店舗専用ページ', 'ディレクトリ・地名×ジャンル掲載', '基本情報・特徴タグ', '問い合わせ導線'],
    cta: '無料で掲載する',
    highlight: false,
  },
  {
    key: 'official',
    name: '公式店舗',
    price: '¥9,800',
    unit: '/ 月',
    lead: '選ばれるページへ。',
    features: ['無料掲載のすべて', '写真・ギャラリー強化', 'メニュー・クーポン掲載', '公式店舗バッジ', 'アクセス分析', 'オーナー自己編集'],
    cta: '公式店舗にする',
    highlight: true,
  },
  {
    key: 'growth',
    name: '集客プラン',
    price: '¥29,800',
    unit: '/ 月',
    lead: '攻めの集客。',
    features: ['公式店舗のすべて', '取材記事の制作・公開', 'モデルコース・特集掲載', 'SNS／AI検索対策', 'キャンペーン企画'],
    cta: '集客を相談する',
    highlight: false,
  },
  {
    key: 'partner',
    name: '地域DXパートナー',
    price: '要相談',
    unit: '¥10万〜',
    lead: 'WEBまるごと。',
    features: ['集客プランのすべて', '公式HP制作・保守', '予約システム導入', 'LINE・CRM連携', '運用の内製化支援'],
    cta: 'DXを相談する',
    highlight: false,
  },
];

// 機能比較表（○＝含む）
const compareRows: { label: string; on: string[] }[] = [
  { label: '店舗専用ページ', on: ['free', 'official', 'growth', 'partner'] },
  { label: 'ディレクトリ・地名×ジャンル掲載', on: ['free', 'official', 'growth', 'partner'] },
  { label: '写真・ギャラリー強化', on: ['official', 'growth', 'partner'] },
  { label: 'メニュー・クーポン掲載', on: ['official', 'growth', 'partner'] },
  { label: '公式店舗バッジ', on: ['official', 'growth', 'partner'] },
  { label: 'アクセス分析', on: ['official', 'growth', 'partner'] },
  { label: 'オーナー自己編集', on: ['official', 'growth', 'partner'] },
  { label: '取材記事・特集の制作', on: ['growth', 'partner'] },
  { label: 'モデルコース掲載', on: ['growth', 'partner'] },
  { label: 'SNS／AI検索対策', on: ['growth', 'partner'] },
  { label: '公式HP・予約・CRM', on: ['partner'] },
];

// よくある質問
const bizFaq = [
  { q: '無料掲載でも本当に費用はかかりませんか？', a: 'はい。無料掲載は0円で、店舗ページやエリア・ジャンルのまとめに掲載されます。まず反応を見てから、公式店舗へ進むかご判断いただけます。' },
  { q: '公式店舗にすると何が変わりますか？', a: '写真やメニュー・クーポンを充実でき、公式バッジ・アクセス分析・オーナー自己編集が使えます。検索やAI検索から「選ばれる」情報量のページになります。' },
  { q: '途中でプランを変更・解約できますか？', a: '可能です。反応や季節にあわせて、公式店舗↔集客プランの切り替えや一時停止のご相談も承ります。' },
  { q: '写真がありませんが大丈夫ですか？', a: '取材・撮影からお手伝いできます（集客プラン以上）。無料掲載は上品なデザインのフォールバックで表示されるので、写真なしでも見栄えします。' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: bizFaq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="掲載のご案内｜茨城のお店・企業さまへ"
  description="茨城のお店・企業の掲載は無料から。公式店舗（月額9,800円）で写真・クーポン・アクセス分析、集客プランで取材記事やSNS/AI検索対策まで。現地取材の地域メディアで“選ばれる”お店に。"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="biz-hero">
    <div class="wrap">
      <p class="eyebrow" data-reveal>For Business — 掲載のご案内</p>
      <h1 class="display biz-h1" data-reveal>
        「イバトコから、<br /><span class="hl">お客さんが来た</span>」を、<br />いっしょに作りませんか。
      </h1>
      <p class="biz-hero-lead" data-reveal>
        ただのまとめサイトでも、ただのWeb制作会社でもありません。<br class="pc" />
        現場の泥臭い取材とSNSの爆発力で、茨城のお店の“最初のお客さん”を連れてきます。
      </p>
      <div class="biz-hero-cta" data-reveal>
        <a href="/contact/?subject=掲載相談" class="btn btn--shu btn--lg">無料で相談する <span class="arw">→</span></a>
        <a href="#plans" class="btn btn--ghost btn--lg">料金を見る</a>
      </div>
    </div>
  </section>

  <!-- 3 Phases -->
  <section class="wrap section">
    <div class="sec-head" data-reveal><h2>集客から、WEBの相棒へ<span class="latin num"> / 3 Steps</span></h2></div>
    <ol class="phase-list">
      {phases.map((p) => (
        <li class="phase" data-reveal style={`--_a:${p.color}`}>
          <div class="phase-n latin">{p.n}</div>
          <div class="phase-body">
            <span class="chip" style="--_a:var(--_a);color:var(--_a);border-color:color-mix(in srgb,var(--_a) 50%,transparent)">{p.tag}</span>
            <h3 class="display phase-title">{p.title}</h3>
            <p class="phase-text">{p.body}</p>
            <p class="phase-price mincho">{p.price}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Value / 素材二重取り -->
  <section class="value">
    <div class="wrap value-inner">
      <div data-reveal>
        <p class="eyebrow">Why Ibatoco</p>
        <h2 class="display value-title">1回の取材で、<br />1ヶ月分の素材を。</h2>
      </div>
      <div class="value-text" data-reveal>
        <p>
          通常の制作会社はSNS運用のたびに撮影に行きます。イバトコは
          <b>メディア取材のときに1ヶ月分をまとめ撮り</b>。だから追加の撮影コストなしで、
          お店のSNS運用まで一気通貫。浮いたコストは、そのままお店への価値になります。
        </p>
        <ul class="value-points">
          <li><b>取材はプロが撮影</b><span>スマホ縦型動画からリールまで</span></li>
          <li><b>4大SNSに最適化</b><span>Instagram / TikTok / X / Threads</span></li>
          <li><b>ご当地レポーター</b><span>地元にファンを持つ公式アンバサダー</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Plans -->
  <section id="plans" class="wrap section">
    <div class="sec-head" data-reveal><h2>料金プラン<span class="latin num"> / Plans</span></h2></div>
    <p class="plan-intro mincho" data-reveal>0円で始めて、反応を見ながら育てる。無理なく“稼げる”お店へ。</p>
    <div class="plan-grid">
      {plans.map((pl) => (
        <div class={`plan ${pl.highlight ? 'plan--hl' : ''}`} data-reveal>
          {pl.highlight && <span class="plan-ribbon">いちばん人気</span>}
          <p class="plan-lead mincho">{pl.lead}</p>
          <h3 class="plan-name display">{pl.name}</h3>
          <p class="plan-price"><span class="latin plan-amt">{pl.price}</span><span class="plan-unit">{pl.unit}</span></p>
          <ul class="plan-features">
            {pl.features.map((f) => <li>{f}</li>)}
          </ul>
          <a href={`/contact/?subject=${encodeURIComponent(pl.name)}&detail=${encodeURIComponent(`「${pl.name}」プランについて相談したいです。`)}`} class={`btn ${pl.highlight ? 'btn--shu' : 'btn--ghost'} plan-cta`}>{pl.cta} <span class="arw" aria-hidden="true">→</span></a>
        </div>
      ))}
    </div>
    <p class="plan-note muted">※ 価格は税別・目安です。お店の状況にあわせて最適なプランをご提案します。地域DXは内容により個別お見積り。</p>

    <!-- 機能比較表 -->
    <div class="compare-wrap" data-reveal>
      <h3 class="display compare-h">プランの違いを一覧で</h3>
      <div class="compare-scroll">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col" class="compare-feat">機能</th>
              {plans.map((pl) => (
                <th scope="col" class={pl.highlight ? 'is-hl' : ''}>
                  <span class="compare-plan">{pl.name}</span>
                  <span class="compare-price latin">{pl.price}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {compareRows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {plans.map((pl) => (
                  <td class={pl.highlight ? 'is-hl' : ''}>
                    {row.on.includes(pl.key) ? <span class="yes" aria-label="含む">●</span> : <span class="no" aria-label="含まない">—</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- FAQ -->
    <div class="biz-faq" data-reveal>
      <h3 class="display compare-h">よくあるご質問</h3>
      <dl class="biz-faq-list">
        {bizFaq.map((f) => (
          <div class="biz-faq-item">
            <dt>Q. {f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- 最終CTA -->
    <div class="biz-final" data-reveal>
      <p class="mincho biz-final-h">まずは、無料掲載から。</p>
      <p class="muted">ご相談は無料です。お店の状況をお聞きして、ぴったりのはじめ方をご提案します。</p>
      <div class="biz-final-cta">
        <a href="/contact/?subject=掲載相談" class="btn btn--shu btn--lg">無料で相談する <span class="arw">→</span></a>
        <a href="/place/" class="btn btn--ghost btn--lg">掲載イメージを見る</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .section { padding-block: clamp(3rem, 7vw, 6rem); }
  .biz-hero { padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(2rem, 5vw, 4rem); background: radial-gradient(80% 100% at 100% 0%, color-mix(in srgb, var(--shu) 10%, transparent), transparent 60%); }
  .biz-h1 { font-size: var(--step-5); line-height: 1.22; }
  .biz-h1 .hl { color: var(--shu); }
  .biz-hero-lead { margin-top: 1.8rem; font-size: var(--step-1); color: var(--ink-soft); line-height: 1.9; }
  .biz-hero-cta { margin-top: 2.4rem; display: flex; gap: 1rem; flex-wrap: wrap; }

  .phase-list { display: grid; gap: 1px; margin-top: 2.5rem; background: var(--line); border-block: 1px solid var(--line); }
  .phase { background: var(--paper); display: grid; grid-template-columns: 120px 1fr; gap: clamp(1rem, 3vw, 2.5rem); padding: clamp(1.8rem, 4vw, 3rem) 0.5rem; align-items: start; }
  .phase-n { font-size: var(--step-5); color: color-mix(in srgb, var(--_a) 30%, var(--paper-3)); line-height: 1; }
  .phase-title { font-size: var(--step-2); margin: 0.6rem 0 0.8rem; }
  .phase-text { color: var(--ink-soft); max-width: 60ch; }
  .phase-price { margin-top: 1rem; font-size: var(--step-1); color: var(--_a); font-weight: 700; }

  .value { background: var(--ai-deep); color: var(--paper); }
  .value-inner { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(2rem, 5vw, 4rem); padding-block: clamp(3.5rem, 8vw, 6rem); align-items: center; }
  .value-title { font-size: var(--step-4); }
  .value-text p { color: rgba(245,241,232,.85); font-size: var(--step-1); line-height: 1.95; }
  .value-text b { color: #fff; }
  .value-points { margin-top: 2rem; display: grid; gap: 1rem; }
  .value-points li { display: flex; flex-direction: column; padding: 1rem 0; border-top: 1px solid rgba(245,241,232,.18); }
  .value-points b { color: #fff; font-size: var(--step-1); }
  .value-points span { color: rgba(245,241,232,.6); font-size: var(--step--1); }

  .plan-intro { font-size: var(--step-1); color: var(--ink-soft); margin-top: 0.6rem; }
  .plan-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; margin-top: 2.5rem; align-items: stretch; }
  .plan { position: relative; border: 1px solid var(--line-strong); border-radius: var(--radius); padding: 1.8rem 1.4rem; display: grid; gap: 0.6rem; align-content: start; background: var(--paper); }
  .plan--hl { border-color: var(--shu); border-width: 2px; box-shadow: var(--shadow); }
  .plan-ribbon { position: absolute; top: -0.8rem; left: 50%; transform: translateX(-50%); white-space: nowrap; background: var(--shu); color: #fff; font-size: var(--step--1); font-weight: 700; padding: 0.3em 1em; border-radius: 999px; }
  .plan-lead { color: var(--ink-mute); font-size: var(--step--1); }
  .plan-name { font-size: var(--step-1); }
  .plan-price { display: flex; align-items: baseline; gap: 0.3em; margin-bottom: 0.4rem; }
  .plan-amt { font-size: var(--step-3); color: var(--shu-deep); font-weight: 700; }
  .plan-unit { font-size: var(--step--1); color: var(--ink-mute); }
  .plan-features { display: grid; gap: 0.55rem; margin: 0.5rem 0 1.4rem; }
  .plan-features li { position: relative; padding-left: 1.5em; color: var(--ink-soft); font-size: var(--step--1); line-height: 1.5; }
  .plan-features li::before { content: "✓"; position: absolute; left: 0; color: var(--matcha); font-weight: 700; }
  .plan-cta { justify-content: center; width: 100%; margin-top: auto; }
  .plan-note { margin-top: 1.4rem; font-size: var(--step--1); }

  /* 機能比較表 */
  .compare-wrap { margin-top: clamp(3rem, 7vw, 5rem); }
  .compare-h { font-size: var(--step-2); text-align: center; margin-bottom: 1.6rem; }
  .compare-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .compare { width: 100%; min-width: 640px; border-collapse: collapse; font-size: var(--step-0); }
  .compare th, .compare td { padding: 0.85rem 0.9rem; text-align: center; border-bottom: 1px solid var(--line); }
  .compare thead th { vertical-align: bottom; border-bottom: 2px solid var(--line-strong); }
  .compare .compare-feat, .compare tbody th { text-align: left; }
  .compare tbody th { font-weight: 500; color: var(--ink); font-size: var(--step--1); }
  .compare-plan { display: block; font-weight: 700; font-family: var(--font-display); font-size: var(--step-0); }
  .compare-price { display: block; font-size: var(--step--1); color: var(--shu-deep); margin-top: 0.2rem; }
  .compare th.is-hl, .compare td.is-hl { background: color-mix(in srgb, var(--shu) 6%, transparent); }
  .compare thead th.is-hl { border-bottom-color: var(--shu); }
  .compare .yes { color: var(--matcha); font-size: var(--step-0); }
  .compare .no { color: var(--line-strong); }

  /* FAQ */
  .biz-faq { margin-top: clamp(3rem, 7vw, 5rem); }
  .biz-faq-list { display: grid; gap: 0.9rem; margin-top: 1.6rem; max-width: 820px; margin-inline: auto; }
  .biz-faq-item { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.3rem; background: var(--paper); }
  .biz-faq-item dt { font-weight: 700; color: var(--ink); }
  .biz-faq-item dd { color: var(--ink-soft); margin-top: 0.5rem; padding-left: 1.4em; line-height: 1.8; }

  /* 最終CTA */
  .biz-final { text-align: center; margin-top: clamp(3rem, 7vw, 5rem); background: var(--paper-2); border-radius: var(--radius); padding: clamp(2.2rem, 5vw, 3.5rem); display: grid; gap: 0.5rem; justify-items: center; }
  .biz-final-h { font-size: var(--step-3); color: var(--ink); }
  .biz-final-cta { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 1.2rem; }

  .pc { display: inline; }
  @media (max-width: 1000px) { .plan-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 860px) {
    .value-inner { grid-template-columns: 1fr; }
    .phase { grid-template-columns: 70px 1fr; }
    .phase-n { font-size: var(--step-4); }
  }
  @media (max-width: 520px) { .plan-grid { grid-template-columns: 1fr; } .pc { display: none; } }
</style>
