---
import BrandBase from '../layouts/BrandBase.astro'; import { SITE_CONFIG } from '../data/site'; const FORM_ENDPOINT=SITE_CONFIG.formEndpoint;
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../lib/seo';
const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: 'お問い合わせ' }];
---
<BrandBase title="お問い合わせ｜イバトコ" description="取材、情報掲載、訂正、地域事業者向け支援など、イバトコへのお問い合わせ。" jsonLd={breadcrumbJsonLd(crumbs, Astro.site)}>
  <section class="contact bp-wrap">
    <Breadcrumbs items={crumbs} />
    <header><p class="bp-kicker">CONTACT</p><h1><span>話を聞くところから、</span><span>始めます。</span></h1><p>取材、掲載、訂正、発信支援など、ご用件をお知らせください。内容を確認し、必要な担当からご連絡します。</p><a href={`mailto:${SITE_CONFIG.contactEmail}`}>{SITE_CONFIG.contactEmail}</a></header>
    <form class="contact-form" method="POST" action={FORM_ENDPOINT||undefined} data-endpoint={FORM_ENDPOINT}>
      <input type="hidden" name="_subject" value="【イバトコ】お問い合わせ" />
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="honeypot" />
      <div class="field"><label for="subject">ご用件</label><select id="subject" name="subject" required><option value="">選択してください</option><option value="取材・掲載相談">取材・情報掲載について</option><option value="地域事業者の相談">Web・発信支援について</option><option value="訂正・更新">掲載内容の訂正・更新</option><option value="ローカルエディター">ローカルエディターについて</option><option value="協業希望">協業・提携</option><option value="その他">その他</option></select></div>
      <div class="field"><label for="name">お名前 / 店舗・企業名</label><input id="name" name="name" type="text" required autocomplete="organization" /></div>
      <div class="field"><label for="email">メールアドレス</label><input id="email" name="email" type="email" required autocomplete="email" /></div>
      <div class="field"><label for="tel">電話番号（任意）</label><input id="tel" name="tel" type="tel" autocomplete="tel" /></div>
      <div class="field"><label for="message">お問い合わせ内容</label><textarea id="message" name="message" rows="7" required></textarea></div>
      <button type="submit">内容を送信する →</button><p class="privacy">送信前に<a href="/privacy/">プライバシーポリシー</a>をご確認ください。</p><p class="form-status" data-status role="status" aria-live="polite" hidden></p>
    </form>
  </section>
</BrandBase>
<style>
  .contact{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(3rem,8vw,8rem);padding-block:clamp(5rem,11vw,9rem)}.contact h1{margin-top:1rem;font:600 clamp(2rem,6vw,5rem)/1.3 var(--font-brand-display);color:var(--color-ink)}.contact h1 span{display:block}.contact header>p:not(.bp-kicker){margin-top:1.5rem;line-height:2;color:var(--color-soil)}.contact header>a{display:inline-block;margin-top:2rem;color:var(--color-tide);border-bottom:1px solid}
  .contact-form{display:grid;grid-template-columns:1fr 1fr;gap:1.4rem}.field{display:grid;gap:.5rem}.field:first-of-type,.field:nth-of-type(2),.field:last-of-type{grid-column:1/-1}label{font-size:.78rem;font-weight:600;color:var(--color-soil)}input,select,textarea{width:100%;padding:.9rem 0;border:0;border-bottom:1px solid var(--color-mist);border-radius:0;background:transparent;color:var(--color-ink);font:inherit}input:focus,select:focus,textarea:focus{outline:0;border-color:var(--color-tide);box-shadow:0 2px 0 var(--color-tide)}textarea{resize:vertical}.contact-form button{justify-self:start;margin-top:.8rem;padding:.7rem 0;border:0;border-bottom:1px solid var(--color-tide);background:transparent;color:var(--color-ink);font:600 1rem var(--font-brand-body);cursor:pointer}.privacy{align-self:center;color:var(--color-soil);font-size:.72rem}.privacy a{border-bottom:1px solid}.form-status{grid-column:1/-1}.honeypot{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
  @media(max-width:760px){.contact,.contact-form{grid-template-columns:1fr}.field{grid-column:1!important}}
  @media(max-width:360px){.contact h1{font-size:1.8rem;line-height:1.4}}
</style>
<script>
  import { submitForm } from '../lib/forms'; const form=document.querySelector<HTMLFormElement>('.contact-form'); const params=new URLSearchParams(location.search); const subject=params.get('subject'); const select=document.getElementById('subject') as HTMLSelectElement|null;
  if(subject&&select){let option=Array.from(select.options).find((item)=>item.value===subject||item.textContent?.trim()===subject);if(!option){option=new Option(subject,subject);select.add(option,1)}select.value=option.value;const detail=params.get('detail');const message=document.getElementById('message') as HTMLTextAreaElement|null;if(detail&&message&&!message.value)message.value=detail}
  if(form){form.addEventListener('submit',()=>{const type=(form.elements.namedItem('subject') as HTMLSelectElement|null)?.value||'お問い合わせ';const name=((form.elements.namedItem('name') as HTMLInputElement|null)?.value||'').trim();const field=form.querySelector<HTMLInputElement>('input[name="_subject"]');if(field)field.value=name?`【${type}】${name}`:`【${type}】お問い合わせ`});submitForm(form,{successText:'お問い合わせを受け付けました。内容を確認してご連絡します。'})}
</script>
