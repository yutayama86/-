---
import BrandBase from '../layouts/BrandBase.astro';
import BrandStoryCard from '../components/BrandStoryCard.astro';
import ThemeNav from '../components/ThemeNav.astro';
import EditorialProcess from '../components/EditorialProcess.astro';
import AreaExplorer from '../components/AreaExplorer.astro';
import PersonCard from '../components/PersonCard.astro';
import { getPublishedArticles } from '../lib/content';
import { VISIBLE_REPORTERS } from '../data/reporters';

const articles = await getPublishedArticles();
const lead = articles[0];
const latest = articles.slice(1, 4);
const people = VISIBLE_REPORTERS.slice(0, 2);
const themeImages = Object.fromEntries(
  articles.filter((article) => article.data.cover).map((article) => [article.data.category, { src: article.data.cover!, alt: article.data.coverAlt }])
);
---

<BrandBase>
  <section class="home-hero">
    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/0/09/Sunrise_of_the_Pacific_Ocean_-_Oarai_coast.jpg/1280px-Sunrise_of_the_Pacific_Ocean_-_Oarai_coast.jpg" alt="大洗海岸から望む日の出" fetchpriority="high" />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="bp-wrap hero-inner">
      <div class="hero-copy">
        <p class="hero-place">茨城県・大洗海岸</p>
        <p class="bp-kicker">茨城を歩いて、つくるメディア。</p>
        <h1 class="bp-title">まだ知らない茨城へ、<br />会いに行く。</h1>
        <p class="hero-lead">店を続ける人、受け継がれる仕事、いつもの風景。現地で会って、聞いて、確かめた茨城を届けます。</p>
        <div class="hero-actions">
          <a href={lead ? '#latest' : '#discover'}>{lead ? '最新の物語を読む →' : '気になる茨城を探す →'}</a>
          <a href="/about/">イバトコについて</a>
        </div>
      </div>
      <p class="hero-credit">写真：t.kunikuni / CC BY-SA 2.0</p>
    </div>
  </section>

  {lead ? (
    <section class="bp-wrap bp-section" id="latest">
      <p class="bp-kicker">FEATURED STORY</p>
      <div class="feature"><BrandStoryCard article={lead} featured /></div>
    </section>
  ) : null}

  {latest.length > 0 && (
    <section class="latest bp-wrap bp-section">
      <header><div><p class="bp-kicker">LATEST STORIES</p><h2 class="bp-section-title">新しく届いた、地域の声。</h2></div><a class="bp-link" href="/eat/">すべて読む</a></header>
      <div class="latest-grid">{latest.map((article) => <BrandStoryCard article={article} />)}</div>
    </section>
  )}

  <section class="discover" id="discover">
    <div class="bp-wrap discover-grid">
      <header class="discover-head">
        <div>
          <p class="bp-kicker">テーマから探す</p>
          <h2 class="bp-section-title">気になる茨城から、<br />読みはじめる。</h2>
        </div>
        <p>食べること、働くこと、整えること。<br />土地の日常を、六つの入口からたどります。</p>
      </header>
      <ThemeNav images={themeImages} />
    </div>
  </section>

  <section class="area-home" id="area">
    <div class="bp-wrap"><header><p class="bp-kicker">街から探す</p><h2 class="bp-section-title">44の街から、茨城を読む。</h2><p>市町村を選ぶと、その街の記事・場所・人が表示されます。</p></header><AreaExplorer /></div>
  </section>

  {people.length > 0 && <section class="people bp-wrap bp-section" id="editors">
    <header><div><p class="bp-kicker">LOCAL EDITORS</p><h2 class="bp-section-title">街を歩く人が、街を書く。</h2></div><p>その街をよく知り、話を丁寧に聞ける人とつくります。</p></header>
    <div class="people-grid">{people.map((person) => <PersonCard person={person} />)}</div>
  </section>}

  <section class="bp-wrap bp-section"><EditorialProcess /></section>

  <section class="partner">
    <div class="bp-wrap"><p class="bp-kicker">FOR LOCAL BUSINESSES</p><h2>地域事業者の方へ</h2><p>取材・情報掲載・発信支援についてご案内します。</p><a href="/biz/">取り組みについて知る →</a></div>
  </section>
</BrandBase>

<style>
  .home-hero{position:relative;min-height:min(780px,calc(100svh - 72px));display:flex;align-items:flex-end;overflow:hidden;background:var(--color-ink);color:#fff}.home-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 55%;filter:saturate(.82) contrast(1.04)}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(11,31,38,.82) 0%,rgba(11,31,38,.48) 48%,rgba(11,31,38,.08) 76%),linear-gradient(0deg,rgba(11,31,38,.46),transparent 55%)}.hero-inner{position:relative;z-index:1;width:100%;padding-block:clamp(4rem,9vw,7.5rem) 2rem}.hero-copy{max-width:52rem}.hero-place{margin-bottom:1.1rem;font-size:.78rem;letter-spacing:.08em}.hero-copy .bp-kicker{color:#fff}.hero-copy .bp-title{margin-top:1.1rem;font-size:clamp(2.5rem,5.4vw,5.3rem);line-height:1.22;color:#fff;text-shadow:0 2px 24px rgba(0,0,0,.18)}
  .hero-lead{max-width:43ch;margin-top:1.5rem;font-size:clamp(.98rem,1.4vw,1.13rem);line-height:1.9;color:rgba(255,255,255,.9)}
  .hero-actions{display:flex;gap:1.6rem;flex-wrap:wrap;margin-top:2rem}.hero-actions a{border-bottom:1px solid rgba(255,255,255,.85);padding-bottom:.25rem;color:#fff;font-weight:700}.hero-credit{position:absolute;right:0;bottom:2rem;font-size:.64rem;color:rgba(255,255,255,.7)}
  .feature{margin-top:2rem}.latest header,.people header{display:flex;justify-content:space-between;gap:2rem;align-items:end}.latest header h2,.people header h2,.area-home h2{margin-top:.6rem}
  .latest-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(1.5rem,3vw,2.5rem);margin-top:2.5rem}
  .discover{background:#F6F1E7;border-top:8px solid var(--color-ink)}.discover-grid{padding-block:clamp(4rem,9vw,7rem)}.discover-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.55fr);gap:clamp(2rem,8vw,8rem);align-items:end;margin-bottom:clamp(2.4rem,5vw,4.25rem)}.discover h2{margin-top:.8rem}.discover-head>p,.area-home header>p:last-child,.people header>p{color:var(--color-soil);line-height:2}.discover-head>p{padding-bottom:.25rem}
  .area-home{background:#E5E1D7;border-top:1px solid var(--color-ink);padding-block:clamp(4rem,8vw,6.5rem)}.area-home header{margin-bottom:2.5rem;display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.55fr);gap:1rem 5rem;align-items:end}.area-home header .bp-kicker{grid-column:1/-1}.area-home header>p:last-child{padding-bottom:.3rem}.people-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:2rem;margin-top:2.5rem}
  .people-empty{margin-top:2.5rem;padding-block:1.5rem;border-block:1px solid var(--color-mist);display:flex;justify-content:space-between;gap:2rem;color:var(--color-soil)}.people-empty a{flex:none;color:var(--color-tide);border-bottom:1px solid}
  .partner{padding-block:3.5rem;border-top:1px solid var(--color-mist)}.partner .bp-wrap{display:grid;grid-template-columns:.5fr 1fr 1fr auto;gap:1.5rem;align-items:center}.partner h2{font:600 1.6rem var(--font-brand-display);color:var(--color-ink)}.partner p:not(.bp-kicker){color:var(--color-soil)}.partner a{border-bottom:1px solid var(--color-tide);font-weight:600}
  @media(max-width:800px){.discover-head,.area-home header{grid-template-columns:1fr}.home-hero{min-height:76svh}.hero-shade{background:linear-gradient(0deg,rgba(11,31,38,.8),rgba(11,31,38,.08) 78%)}.hero-credit{position:static;margin-top:2rem}.latest-grid,.people-grid{grid-template-columns:1fr}.partner .bp-wrap{grid-template-columns:1fr}.latest header,.people header{display:block}.latest header>a{display:inline-block;margin-top:1rem}}
  @media(max-width:480px){.hero-inner{padding-block:5rem 1.4rem}.hero-copy .bp-title{font-size:2.45rem;line-height:1.32}.home-hero>img{object-position:62% center}}
  @media(max-width:360px){.hero-copy .bp-title{font-size:1.8rem;line-height:1.4}}
</style>
