---
import BrandBase from '../layouts/BrandBase.astro';
import ThemeGuide from '../components/ThemeGuide.astro';
import { THEMES } from '../data/themes';
const theme = THEMES.kouyou;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: theme.title, item: new URL('/kouyou/', Astro.site).href },
  ],
};
---
<BrandBase title={theme.metaTitle} description={theme.metaDescription} jsonLd={jsonLd}>
  <ThemeGuide theme={theme} />
</BrandBase>
