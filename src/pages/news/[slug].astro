---
import type { GetStaticPaths } from 'astro';
import BrandBase from '../../layouts/BrandBase.astro';
import NewsCard from '../../components/NewsCard.astro';
import { CATEGORIES, SITE_CONFIG } from '../../data/site';
import { NEWS_CATEGORIES } from '../../data/news';
import { MUNI_BY_SLUG, areaToSlug } from '../../data/areas';
import { formatDate, getArticles, getNews, getRelatedNews, getStores, tagToSlug } from '../../lib/content';

export const getStaticPaths = (async () => (await getNews()).map((item) => ({
  params: { slug: item.id.split('/').pop() },
  props: { item },
}))) satisfies GetStaticPaths;

const { item } = Astro.props;
const { data } = item;
const slug = item.id.split('/').pop();
const canonical = new URL(`/news/${slug}/`, Astro.site ?? SITE_CONFIG.domain).href;
const visualImagePath = data.ogImage ?? '/images/news/news-placeholder.svg';
const imagePath = data.ogImage && !data.ogImage.endsWith('.svg') ? data.ogImage : `/og/news/${slug}.png`;
const absolute = (path: string) => new URL(path, Astro.site ?? SITE_CONFIG.domain).href;
const municipalities = data.municipalities.map((value) => MUNI_BY_SLUG.get(value)).filter(Boolean);
const municipalitySet = new Set(data.municipalities);
const [relatedNews, allArticles, allStores] = await Promise.all([getRelatedNews(item), getArticles(), getStores()]);
const relatedArticles = allArticles.filter((article) => municipalitySet.has(areaToSlug(article.data.area) ?? '')).slice(0, 3);
const relatedPlaces = allStores.filter((store) => municipalitySet.has(areaToSlug(store.data.area) ?? '')).slice(0, 3);
const internalLinkLabels: Record<string, string> = {
  '/news/': '茨城ニュース解説の新着記事',
  '/news/ibaraki-airport-busan-air-busan-charter-2026/': '茨城空港に初の「釜山便」（解説）',
  '/news/mito-hollyhock-soccer-tourism-2026/': '水戸ホーリーホックのサッカーツーリズム（解説）',
  '/news/mito-hollyhock-new-stadium-access/': '水戸信用金庫スタジアムのアクセス・駐車場（水戸駅・東海駅から）',
  '/news/mito-hollyhock-home-opening-13226-regional-impact/': '13,226人が集まったJ1ホーム開幕戦（解説）',
  '/area/naka/': '那珂市の地域情報',
  '/area/tokai/': '東海村の地域情報',
  '/area/omitama/': '小美玉市の地域情報',
  '/area/mito/': '水戸市の地域情報',
  '/area/oarai/': '大洗町の地域情報',
  '/area/hitachinaka/': 'ひたちなか市の地域情報',
  '/area/kasama/': '笠間市の地域情報',
  '/area/kashima/': '鹿嶋市の地域情報',
  '/area/hitachiota/': '常陸太田市の地域情報',
  '/area/tsuchiura/': '土浦市の地域情報',
  '/area/tsukuba/': 'つくば市の地域情報',
  '/area/koga/': '古河市の地域情報',
  '/hana/': '茨城の花（梅・桜・ネモフィラ）',
  '/news/hitachiota-kajual-fruit-farm-dx/': '常陸太田市KAJUALに見る地域観光DX（解説）',
  '/ko/': '한국어：茨城の旅行ガイド（韓国語版）',
  '/area/daigo/': '大子町の地域情報',
  '/news/ibaraki-passport-44-municipalities/': 'IBARAKI PASSPORTから考える茨城観光（解説）',
  '/news/ibaraki-food-fairs-tokyo-osaka-2026/': '東京・大阪の茨城フェアに見る「地域外から売上をつくる」（解説）',
  '/news/ibaraki-kaiyo-high-school-collab-menu-2026/': '海洋高校の実習魚が「地域の食」になる（解説）',
  '/umi/': '茨城の海（海岸線190キロと海の幸）',
};

// 04セクションの見出し。accessGuide を持つ記事だけアクセス案内として見せ、
// それ以外は本来の「具体的に何が変わる？」に戻す（目次の表記とも揃える）。
const changesHeading = data.accessGuide ? 'アクセス・駐車場・公共交通' : '具体的に何が変わる？';

const organizationId = `${SITE_CONFIG.domain}/#organization`;
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE_CONFIG.name,
    url: SITE_CONFIG.domain,
    logo: { '@type': 'ImageObject', url: absolute('/favicon.svg') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: data.title,
    description: data.description,
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    author: { '@type': 'Organization', name: data.author },
    publisher: { '@id': organizationId },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    image: [absolute(imagePath)],
    articleSection: NEWS_CATEGORIES[data.category].label,
    keywords: data.tags.join(', '),
    inLanguage: 'ja-JP',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: '茨城ニュース解説', item: absolute('/news/') },
      { '@type': 'ListItem', position: 3, name: data.title, item: canonical },
    ],
  },
];
if (data.event) jsonLd.push({ '@context': 'https://schema.org', '@type': 'Event', name: data.event.name, startDate: data.event.startDate.toISOString(), ...(data.event.endDate ? { endDate: data.event.endDate.toISOString() } : {}), ...(data.event.url ? { url: data.event.url } : {}), ...(data.event.placeName ? { location: { '@type': 'Place', name: data.event.placeName, ...(data.event.address ? { address: data.event.address } : {}) } } : {}) });
if (data.place) jsonLd.push({ '@context': 'https://schema.org', '@type': 'Place', name: data.place.name, ...(data.place.address ? { address: data.place.address } : {}), ...(data.place.url ? { url: data.place.url } : {}) });
if (data.faq.length > 0) jsonLd.push({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
});
---

<BrandBase title={`${data.title}｜イバトコ`} description={data.description} image={imagePath} imageAlt={data.ogImageAlt} type="article" publishedAt={data.pubDate} updatedAt={data.updatedDate ?? data.pubDate} jsonLd={jsonLd} noindex={data.noindex}>
  <article class="news-detail">
    <header class="news-detail__head bp-reading">
      <nav class="crumbs" aria-label="パンくず"><a href="/">ホーム</a><span>/</span><a href="/news/">茨城ニュース解説</a></nav>
      {data.sample && <p class="sample-note"><strong>実装確認用サンプル</strong>　この記事はニュース機能の表示確認用です。実際の施策発表を報じる記事ではありません。</p>}
      <div class="news-detail__meta"><span>{NEWS_CATEGORIES[data.category].label}</span>{municipalities.length > 0 && <span>{municipalities.map((value) => value!.name).join('・')}</span>}</div>
      <h1>{data.title}</h1>
      <p class="news-detail__deck">{data.description}</p>
      {data.tags.length > 0 && <ul class="news-detail__tags" aria-label="記事のタグ">{data.tags.map((tag) => <li><a href={`/tag/${tagToSlug(tag)}/`}>#{tag}</a></li>)}</ul>}
      <div class="news-detail__dates"><time datetime={data.pubDate.toISOString()}>公開 {formatDate(data.pubDate)}</time>{data.updatedDate && <time datetime={data.updatedDate.toISOString()}>更新 {formatDate(data.updatedDate)}</time>}<span>{data.author}</span></div>
    </header>

    <div class="news-detail__layout bp-wrap">
      <aside class="news-detail__toc" aria-label="この記事の目次"><p>この記事の構成</p><ol><li><a href="#conclusion">結論</a></li><li><a href="#points">この記事でわかること</a></li><li><a href="#what-happened">何が起きた？</a></li><li><a href="#changes">{changesHeading}</a></li><li><a href="#analysis">編集部の解説</a></li><li><a href="#impact">地域への影響</a></li><li><a href="#business">地域事業者への示唆</a></li><li><a href="#faq">FAQ</a></li><li><a href="#sources">情報源</a></li></ol></aside>
      <div class="news-detail__body">
        {/* 冒頭画像は本文カラムの先頭に置く（見出しと本文のあいだで浮かせない） */}
        <figure class="news-detail__hero"><img src={visualImagePath} alt={data.ogImageAlt || '茨城ニュース解説のイメージ'} loading="eager" width="1200" height="630" />{data.imageCredit && <figcaption>写真：<a href={data.imageCreditUrl} target="_blank" rel="noopener noreferrer">{data.imageCredit}</a>{data.imageLicense && <> / <a href={data.imageLicenseUrl} target="_blank" rel="noopener noreferrer">{data.imageLicense}</a></>}</figcaption>}</figure>

        <section id="conclusion" class="news-conclusion"><p class="section-number">01 / CONCLUSION</p><h2>結論</h2><p>{data.conclusion}</p></section>
        <section id="points"><p class="section-number">02 / KEY POINTS</p><h2>この記事でわかること</h2><ul>{data.keyPoints.map((point) => <li>{point}</li>)}</ul></section>
        <section id="what-happened"><p class="section-number">03 / WHAT HAPPENED</p><h2>何が起きた？</h2><p>{data.whatHappened}</p></section>
        <section id="changes"><p class="section-number">04 / CHANGES</p><h2>{changesHeading}</h2><p>{data.whatChanges}</p>
          {data.accessGuide && <div class="access-guide">
            <div><h3>場所とホーム利用開始時期</h3><dl><dt>場所</dt><dd>{data.accessGuide.location}</dd><dt>いつから</dt><dd>{data.accessGuide.homeUseStarts}</dd></dl></div>
            <div><h3>車・駐車場</h3><dl>{data.accessGuide.parking.map((item) => <><dt>{item.heading}</dt><dd>{item.detail}</dd></>)}</dl></div>
            <div><h3>電車・無料シャトルバス</h3><dl>{data.accessGuide.publicTransport.map((item) => <><dt>{item.heading}</dt><dd>{item.detail}</dd></>)}</dl></div>
            <div><h3>帰りの動線</h3><p>{data.accessGuide.returnTrip}</p></div>
          </div>}
        </section>
        <section id="analysis"><p class="section-number">05 / EDITORIAL VIEW</p><h2>イバトコ編集部の解説</h2><p>{data.editorialAnalysis}</p></section>
        <section id="impact"><p class="section-number">06 / LOCAL IMPACT</p><h2>地域への影響</h2><p>{data.regionalImpact}</p></section>
        <section id="business"><p class="section-number">07 / FOR BUSINESSES</p><h2>地域事業者への示唆</h2><ul>{data.businessImplications.map((point) => <li>{point}</li>)}</ul></section>
        {data.faq.length > 0 && <section id="faq"><p class="section-number">08 / FAQ</p><h2>よくある質問</h2><dl class="news-faq">{data.faq.map((item) => <div><dt>{item.question}</dt><dd>{item.answer}</dd></div>)}</dl></section>}
        <section id="sources"><p class="section-number">09 / SOURCES</p><h2>情報源</h2><ul class="source-list">{data.sourceUrls.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a>{source.accessedAt && <small>確認日：{formatDate(source.accessedAt)}</small>}</li>)}</ul><p class="source-note">掲載内容は公開情報をもとに編集しています。制度や運用は変更される場合があるため、行動前に公式情報をご確認ください。</p></section>
      </div>
    </div>
  </article>

  {(relatedNews.length > 0 || relatedArticles.length > 0 || relatedPlaces.length > 0 || municipalities.length > 0) && <section class="news-related bp-wrap bp-section"><p class="bp-kicker">10 / RELATED</p><h2 class="bp-section-title">関連情報</h2>
    {municipalities.length > 0 && <div class="municipality-links">{municipalities.map((value) => <a href={`/area/${value!.slug}/`}>{value!.name}を知る →</a>)}</div>}
    {relatedNews.length > 0 && <div class="news-related__grid">{relatedNews.map((related) => <NewsCard item={related} compact />)}</div>}
    {(relatedArticles.length > 0 || relatedPlaces.length > 0) && <div class="local-links">{relatedArticles.map((article) => <a href={`/${CATEGORIES[article.data.category].path}/${article.id.split('/').pop()}/`}><span>記事</span>{article.data.title}</a>)}{relatedPlaces.map((place) => <a href={`/place/${place.id}/`}><span>場所</span>{place.data.name}</a>)}</div>}
    {data.relatedArticleUrls.length > 0 && <nav class="editorial-links" aria-label="編集部が選んだ関連記事">{data.relatedArticleUrls.map((url) => <a href={url}>{internalLinkLabels[url] ?? '関連情報'} →</a>)}</nav>}
  </section>}
</BrandBase>

<style>
  .news-detail{padding-top:clamp(3.5rem,8vw,6.5rem)}.crumbs{display:flex;gap:.55rem;margin-bottom:1.5rem;color:var(--color-soil);font-size:.75rem}.crumbs a{border-bottom:1px solid transparent}.crumbs a:hover{border-color:var(--color-tide)}.sample-note{margin-bottom:1.5rem;padding:1rem;border-left:3px solid var(--color-signal);background:color-mix(in srgb,var(--color-signal) 7%,var(--color-white));font-size:.78rem;line-height:1.7}.sample-note strong{color:var(--color-signal)}
  .news-detail__meta{display:flex;gap:1rem;color:var(--color-tide);font:.72rem var(--font-brand-meta);letter-spacing:.08em}.news-detail__head h1{max-width:19em;margin-top:1rem;font:600 clamp(2rem,4vw,3.35rem)/1.38 var(--font-brand-display);color:var(--color-ink)}.news-detail__deck{max-width:46rem;margin-top:1.3rem;color:var(--color-soil);font-size:clamp(1rem,1.6vw,1.15rem);line-height:1.9}.news-detail__tags{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.25rem;list-style:none}.news-detail__tags a{display:block;padding:.4rem .7rem;background:color-mix(in srgb,var(--color-tide) 8%,var(--color-white));color:var(--color-tide);font-size:.72rem;transition:background-color .2s,color .2s}.news-detail__tags a:hover,.news-detail__tags a:focus-visible{background:var(--color-tide);color:var(--color-white)}.news-detail__dates{display:flex;flex-wrap:wrap;gap:.5rem 1.25rem;margin-top:1.25rem;color:var(--color-soil);font-size:.72rem}.news-detail__hero{margin-top:3rem}.news-detail__hero img{width:100%;aspect-ratio:1.9/1;object-fit:cover}.news-detail__hero figcaption{margin-top:.55rem;color:var(--color-soil);font-size:.68rem;text-align:right}.news-detail__hero figcaption a{text-decoration:underline;text-underline-offset:.15em}
  .news-detail__layout{display:grid;grid-template-columns:210px minmax(0,700px);justify-content:center;gap:clamp(2rem,6vw,5rem);padding-block:clamp(3.5rem,7vw,6rem)}.news-detail__toc{position:sticky;top:1rem;align-self:start;padding-top:.5rem;color:var(--color-soil);font-size:.72rem}.news-detail__toc>p{padding-bottom:.65rem;border-bottom:1px solid var(--color-mist);font-weight:700;color:var(--color-ink)}.news-detail__toc ol{display:grid;gap:.5rem;margin-top:.75rem;list-style:decimal;padding-left:1.2rem}.news-detail__toc a:hover{color:var(--color-tide)}
  .news-detail__body section{scroll-margin-top:1rem}.news-detail__body section+section{margin-top:4rem;padding-top:3rem;border-top:1px solid var(--color-mist)}.section-number{color:var(--color-tide);font:.68rem var(--font-brand-meta);letter-spacing:.12em}.news-detail__body h2{margin-top:.6rem;font:600 clamp(1.55rem,3vw,2.25rem)/1.4 var(--font-brand-display);color:var(--color-ink)}.news-detail__body h2+p,.news-detail__body h2+ul,.news-faq,.source-list{margin-top:1.3rem}.news-detail__body p,.news-detail__body li,.news-detail__body dd{color:var(--color-charcoal);font-size:1rem;line-height:2}.news-detail__body ul:not(.source-list){display:grid;gap:.65rem}.news-detail__body ul:not(.source-list) li{position:relative;padding-left:1.1rem}.news-detail__body ul:not(.source-list) li:before{content:'';position:absolute;left:0;top:.9em;width:5px;height:5px;background:var(--color-tide)}.news-conclusion{padding:1.5rem!important;background:var(--color-white);border:1px solid var(--color-mist)!important}
  .access-guide{display:grid;gap:1px;margin-top:2rem;background:var(--color-mist);border:1px solid var(--color-mist)}.access-guide>div{padding:1.25rem;background:var(--color-white)}.access-guide h3{font:600 1.15rem/1.5 var(--font-brand-display);color:var(--color-ink)}.access-guide dl{display:grid;grid-template-columns:minmax(7rem,.7fr) minmax(0,2fr);gap:.65rem 1rem;margin-top:1rem}.access-guide dt{font-weight:700;color:var(--color-tide)}.access-guide dd{margin:0}.access-guide h3+p{margin-top:.75rem}
  .news-faq{border-top:1px solid var(--color-mist)}.news-faq div{padding-block:1.2rem;border-bottom:1px solid var(--color-mist)}.news-faq dt{font-weight:700;color:var(--color-ink)}.news-faq dd{margin-top:.45rem}.source-list{display:grid;gap:1rem}.source-list li{display:grid}.source-list a{color:var(--color-tide);text-decoration:underline;text-underline-offset:.2em}.source-list small{margin-top:.2rem;color:var(--color-soil);font-size:.68rem}.source-note{margin-top:1.5rem;padding:1rem;background:var(--color-white);font-size:.78rem!important;color:var(--color-soil)!important}
  .news-related{border-top:1px solid var(--color-mist)}.news-related .bp-section-title{margin-top:.6rem}.municipality-links{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.5rem}.municipality-links a{padding:.65rem .9rem;border:1px solid var(--color-tide);color:var(--color-tide);font-size:.78rem}.news-related__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:2rem}.local-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;margin-top:2rem;background:var(--color-mist)}.local-links a{display:grid;gap:.3rem;padding:1rem;background:var(--color-white);font-weight:600;color:var(--color-ink)}.local-links span{color:var(--color-tide);font-size:.66rem;letter-spacing:.1em}
  .editorial-links{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.25rem}.editorial-links a{padding:.65rem .9rem;background:var(--color-white);border:1px solid var(--color-mist);color:var(--color-tide);font-size:.78rem}
  @media(max-width:760px){.news-detail__layout{grid-template-columns:1fr}.news-detail__toc{position:static}.news-related__grid,.local-links{grid-template-columns:1fr}.news-detail__head h1{font-size:clamp(1.85rem,9vw,2.75rem)}.access-guide dl{grid-template-columns:1fr}.access-guide dd+dt{margin-top:.5rem}}
</style>
