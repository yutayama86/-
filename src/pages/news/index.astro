---
import BrandBase from '../../layouts/BrandBase.astro';
import type { Crumb } from '../../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import NewsCard from '../../components/NewsCard.astro';
import { getNews } from '../../lib/content';

const news = await getNews();
const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: '茨城ニュース解説' }];
---

<BrandBase
  title="茨城ニュース解説｜イバトコ"
  description="茨城県の自治体、観光、地域経済、交通、スポーツ、DX、スタートアップなどの重要ニュースを、イバトコ編集部が地域への影響とともに解説します。"
 jsonLd={breadcrumbJsonLd(crumbs, Astro.site)}>
  <header class="news-index__head bp-wrap">
    <nav aria-label="パンくず"><a href="/">ホーム</a><span>/</span><span aria-current="page">茨城ニュース解説</span></nav>
    <p class="bp-kicker">IBARAKI NEWS EXPLAINED</p>
    <h1>茨城ニュース解説</h1>
    <p>茨城県の自治体、観光、地域経済、交通、スポーツ、DX、スタートアップなどの重要ニュースを、イバトコ編集部が地域への影響とともに解説します。</p>
  </header>

  <section class="news-index__list bp-wrap" aria-labelledby="news-latest">
    <div class="news-index__section-head"><p class="bp-kicker">LATEST</p><h2 id="news-latest">新着の解説</h2></div>
    {news.length > 0 ? <div class="news-grid">{news.map((item) => <NewsCard item={item} />)}</div> : <p class="news-empty">公開準備中です。確認を終えたニュースから掲載します。</p>}
  </section>
</BrandBase>

<style>
  .news-index__head{padding-block:clamp(4rem,8vw,7rem);border-bottom:1px solid var(--color-mist)}.news-index__head nav{display:flex;gap:.55rem;margin-bottom:2rem;color:var(--color-soil);font-size:.74rem}.news-index__head nav a{border-bottom:1px solid transparent}.news-index__head nav a:hover{border-color:var(--color-tide)}
  .news-index__head h1{margin-top:.8rem;font:600 clamp(2.35rem,6vw,5rem)/1.15 var(--font-brand-display);color:var(--color-ink)}.news-index__head>p:last-child{max-width:52rem;margin-top:1.4rem;color:var(--color-soil);font-size:clamp(.95rem,1.5vw,1.08rem);line-height:2}
  .news-index__list{padding-block:clamp(3.5rem,7vw,6rem)}.news-index__section-head h2{margin-top:.6rem;font:600 clamp(1.6rem,3vw,2.4rem) var(--font-brand-display);color:var(--color-ink)}.news-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem;margin-top:2rem}.news-empty{margin-top:2rem;padding:2rem;background:var(--color-white);color:var(--color-soil)}
  @media(max-width:900px){.news-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.news-grid{grid-template-columns:1fr}.news-index__head{padding-top:3rem}}
</style>
