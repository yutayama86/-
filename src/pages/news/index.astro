---
import BrandBase from '../../layouts/BrandBase.astro';
import type { Crumb } from '../../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import NewsCard from '../../components/NewsCard.astro';
import { getNews } from '../../lib/content';

const news = await getNews();
const [featured, ...remainingNews] = news;
const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: '茨城ニュース解説' }];
---

<BrandBase
  title="茨城ニュース解説｜イバトコ"
  description="茨城県の自治体、観光、地域経済、交通、スポーツ、DX、スタートアップなどの重要ニュースを、イバトコ編集部が地域への影響とともに解説します。"
 jsonLd={breadcrumbJsonLd(crumbs, Astro.site)}>
  <header class="news-index__head bp-wrap">
    <nav aria-label="パンくず"><a href="/">ホーム</a><span>/</span><span aria-current="page">茨城ニュース解説</span></nav>
    <p class="bp-kicker">IBARAKI NEWS EXPLAINED</p>
    <h1>茨城ニュース解説</h1>
    <p>茨城県の自治体、観光、地域経済、交通、スポーツ、DX、スタートアップなどの重要ニュースを、イバトコ編集部が地域への影響とともに解説します。</p>
  </header>

  <section class="news-index__list bp-wrap" aria-labelledby="news-latest">
    <div class="news-index__section-head"><p class="bp-kicker">LATEST</p><h2 id="news-latest">新着の解説</h2></div>
    {featured ? (
      <>
        <div class="news-index__featured"><NewsCard item={featured} /></div>
        {remainingNews.length > 0 && <div class="news-grid">{remainingNews.map((item) => <NewsCard item={item} />)}</div>}
      </>
    ) : <p class="news-empty">公開準備中です。確認を終えたニュースから掲載します。</p>}
  </section>
</BrandBase>

<style>
  .news-index__head nav{display:flex;gap:.55rem;color:var(--color-soil);font-size:.74rem}.news-index__head nav a{border-bottom:1px solid transparent}.news-index__head nav a:hover{border-color:var(--color-tide)}
  .news-index__head h1{font-family:var(--font-brand-display);color:var(--color-ink)}.news-index__head>p:last-child{color:var(--color-soil);line-height:2}
  .news-index__section-head{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding-bottom:1rem;border-bottom:1px solid rgba(23,43,53,.15)}.news-index__section-head h2{margin-top:.6rem;font:600 clamp(1.6rem,3vw,2.4rem) var(--font-brand-display);color:var(--color-ink)}
  .news-index__featured{margin-top:1.8rem}.news-index__featured :global(.news-card){min-height:22rem}.news-index__featured :global(.news-card.has-image){grid-template-columns:minmax(0,1.15fr) minmax(22rem,.85fr);grid-template-rows:1fr}.news-index__featured :global(.news-card__image){height:100%;aspect-ratio:auto}.news-index__featured :global(.news-card__body){justify-content:center;padding:clamp(1.5rem,3vw,2.35rem)}.news-index__featured :global(h3){font-size:clamp(1.55rem,2.5vw,2.2rem);line-height:1.48}
  .news-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem;margin-top:1.5rem}.news-empty{margin-top:2rem;padding:2rem;background:var(--color-white);color:var(--color-soil)}
  @media(max-width:900px){.news-index__featured :global(.news-card.has-image){grid-template-columns:1fr;grid-template-rows:auto 1fr}.news-index__featured :global(.news-card__image){height:auto;aspect-ratio:16/9}.news-grid{grid-template-columns:1fr}}@media(max-width:600px){.news-index__featured :global(.news-card){min-height:0}.news-index__head{padding-top:2rem}}
</style>
