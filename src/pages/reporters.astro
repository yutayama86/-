---
import BrandBase from '../layouts/BrandBase.astro';
import PersonCard from '../components/PersonCard.astro';
import { VISIBLE_REPORTERS } from '../data/reporters';
---

<BrandBase title="ローカルエディター｜イバトコ" description="地域を歩き、人に会い、一次情報を記録するイバトコのローカルエディター。" noindex={VISIBLE_REPORTERS.length === 0}>
  <header class="people-head bp-wrap"><p class="bp-kicker">LOCAL EDITORS</p><h1>街を歩き、<br />街を書く人。</h1><p>フォロワー数ではなく、地域への理解、取材への敬意、公開情報への責任を大切にします。</p></header>
  {VISIBLE_REPORTERS.length > 0 ? <section class="people-list bp-wrap">{VISIBLE_REPORTERS.map((person) => <PersonCard person={person} />)}</section> : <section class="people-empty bp-reading"><p class="bp-kicker">PROFILE POLICY</p><h2>人物情報は、本人確認から。</h2><p>本人確認と掲載許諾が完了したローカルエディターだけを公開します。現在、公開可能なプロフィールはありません。</p><a href="/about/team/">編集体制を知る →</a></section>}
  <section class="principles"><div class="bp-wrap"><p class="bp-kicker">OUR STANDARD</p><h2>現地へ行く。話を聞く。事実と印象を分ける。</h2><a href="/about/editorial-policy/">編集方針を読む →</a></div></section>
</BrandBase>

<style>
  .people-head{padding-block:clamp(5rem,11vw,9rem);border-bottom:1px solid var(--color-mist)}.people-head h1{margin-top:1rem;font:600 clamp(2.5rem,7vw,6rem)/1.2 var(--font-brand-display);color:var(--color-ink)}.people-head>p:last-child{max-width:44ch;margin-top:1.5rem;line-height:2;color:var(--color-soil)}
  .people-list{display:grid;grid-template-columns:repeat(2,1fr);gap:2rem;padding-block:clamp(4rem,9vw,7rem)}.people-empty{padding-block:clamp(5rem,11vw,9rem)}.people-empty h2{margin-top:1rem;font:600 clamp(2rem,5vw,4rem)/1.3 var(--font-brand-display);color:var(--color-ink)}.people-empty>p:not(.bp-kicker){margin-top:1.5rem;line-height:2;color:var(--color-soil)}.people-empty a{display:inline-block;margin-top:2rem;color:var(--color-tide);border-bottom:1px solid}
  .principles{padding-block:clamp(4rem,8vw,6rem);background:var(--color-white)}.principles h2{max-width:23ch;margin-top:1rem;font:600 clamp(1.8rem,4vw,3.4rem)/1.4 var(--font-brand-display);color:var(--color-ink)}.principles a{display:inline-block;margin-top:2rem;color:var(--color-tide);border-bottom:1px solid}
  @media(max-width:700px){.people-list{grid-template-columns:1fr}}
</style>
