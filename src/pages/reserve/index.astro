---
import Base from '../../layouts/Base.astro';
import { getPlaces } from '../../lib/content';
import { SITE_CONFIG } from '../../data/site';

const places = await getPlaces();
const FORM_ENDPOINT = SITE_CONFIG.formEndpoint;
---

<Base
  title="予約・お問い合わせ"
  description="イバトコ掲載店舗への予約・お問い合わせフォーム。"
  noindex={true}
>
  <section class="wrap rsv">
    <p class="eyebrow" data-reveal>Reservation</p>
    <h1 class="display rsv-title" data-reveal>予約・お問い合わせ</h1>
    <p class="rsv-lead mincho" data-reveal>
      ご希望のお店を選んで、日時とご連絡先をお送りください。<br />
      お店から折り返しご連絡します。
    </p>

    <form class="rsv-form" data-reveal method="POST" action={FORM_ENDPOINT || undefined} data-endpoint={FORM_ENDPOINT}>
      <input type="hidden" name="_subject" value="【イバトコ】予約申込" />
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
      <div class="field">
        <label for="place">お店・企業</label>
        <select id="place" name="place" required>
          <option value="">選択してください</option>
          {places.map((p) => (
            <option value={p.data.name}>{p.data.name}（{p.data.area}）</option>
          ))}
        </select>
      </div>
      <div class="row">
        <div class="field"><label for="date">ご希望日</label><input id="date" name="date" type="date" /></div>
        <div class="field"><label for="people">人数</label><input id="people" name="people" type="number" min="1" placeholder="2" /></div>
      </div>
      <div class="field"><label for="name">お名前</label><input id="name" name="name" type="text" required autocomplete="name" /></div>
      <div class="row">
        <div class="field"><label for="email">メール</label><input id="email" name="email" type="email" required autocomplete="email" /></div>
        <div class="field"><label for="tel">電話番号</label><input id="tel" name="tel" type="tel" autocomplete="tel" /></div>
      </div>
      <div class="field"><label for="note">ご要望（任意）</label><textarea id="note" name="note" rows="4"></textarea></div>
      <button type="submit" class="btn btn--shu btn--lg rsv-submit">予約を申し込む <span class="arw">→</span></button>
      <p class="form-status" data-status role="status" aria-live="polite" hidden></p>
      <p class="muted rsv-note">
        ※ 現在は仮の予約フォームです。将来的に自社予約システム（決済・CRM連携）へ置き換えます。
      </p>
    </form>
  </section>
</Base>

<style>
  .rsv { max-width: 720px; padding-block: clamp(3rem, 8vw, 5rem); }
  .rsv-title { font-size: var(--step-4); margin: 0.5rem 0 1rem; }
  .rsv-lead { color: var(--ink-soft); font-size: var(--step-1); margin-bottom: 2.5rem; }
  .rsv-form { display: grid; gap: 1.4rem; }
  .field { display: grid; gap: 0.5rem; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; }
  label { font-size: var(--step--1); font-weight: 700; color: var(--ink-soft); }
  input, select, textarea { font: inherit; font-size: var(--step-0); padding: 0.85em 1em; background: var(--paper); border: 1px solid var(--line-strong); border-radius: var(--radius); color: var(--ink); width: 100%; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--shu); box-shadow: 0 0 0 3px color-mix(in srgb, var(--shu) 18%, transparent); }
  .rsv-submit { justify-content: center; }
  .rsv-note { font-size: var(--step--1); }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; } }
</style>

<script>
  import { submitForm } from '../../lib/forms';
  // URLの ?place=xxx でお店を初期選択
  const params = new URLSearchParams(location.search);
  const pid = params.get('place');
  const select = document.querySelector<HTMLSelectElement>('#place');
  if (pid && select) {
    const opt = [...select.options].find((o) => o.value.includes(pid) || o.text.includes(pid));
    if (opt) select.value = opt.value;
  }
  const form = document.querySelector<HTMLFormElement>('.rsv-form');
  if (form) submitForm(form, {
    successText: 'ご予約の申込を受け付けました。お店から折り返しご連絡します。',
    mailSubject: '【イバトコ】予約申込',
  });
</script>
