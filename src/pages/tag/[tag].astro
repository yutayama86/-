---
import type { GetStaticPaths } from 'astro';
import BrandBase from '../../layouts/BrandBase.astro';
import BrandStoryCard from '../../components/BrandStoryCard.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getAllTags, getArticlesByTag, getNewsByTag, tagToSlug } from '../../lib/content';

export const getStaticPaths = (async () => {
  const tags = await getAllTags();
  return tags.map(({ tag }) => ({ params: { tag: tagToSlug(tag) }, props: { tag } }));
}) satisfies GetStaticPaths;

const { tag } = Astro.props;
const [articles, news] = await Promise.all([getArticlesByTag(tag), getNewsByTag(tag)]);
const total = articles.length + news.length;
---

<BrandBase
  title={`#${tag}の記事`}
  description={`「${tag}」に関する茨城の記事とニュース解説をイバトコがまとめました。`}
  noindex={true}
>
  <section class="wrap tag-hero">
    <nav class="crumbs" aria-label="パンくず" data-reveal>
      <a href="/">ホーム</a><span aria-hidden="true">/</span><span>タグ</span>
    </nav>
    <p class="eyebrow" data-reveal>Tag</p>
    <h1 class="display tag-title" data-reveal>#{tag}</h1>
    <p class="tag-lead muted" data-reveal>「{tag}」の記事・ニュース {total}件</p>
  </section>

  <section class="wrap section">
    {news.length > 0 && <div class="tag-group"><p class="eyebrow">News</p><h2>ニュース解説</h2><div class="tag-grid tag-grid--news">{news.map((item) => <NewsCard item={item} />)}</div></div>}
    {articles.length > 0 && <div class="tag-group"><p class="eyebrow">Stories</p><h2>記事</h2><div class="tag-grid">{articles.map((a) => <BrandStoryCard article={a} />)}</div></div>}
    {total === 0 && <p class="empty muted mincho">このタグの記事はまだありません。</p>}
  </section>
</BrandBase>

<style>
  .tag-hero { padding-block: clamp(2.5rem, 6vw, 4rem) 0; }
  .crumbs { display: flex; gap: 0.6rem; font-size: var(--step--1); color: var(--ink-mute); margin-bottom: 1.2rem; }
  .crumbs a:hover { color: var(--color-tide); }
  .tag-title { font-size: var(--step-4); margin: 0.4rem 0; color: var(--ink); }
  .tag-lead { font-size: var(--step-0); }
  .section { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .tag-group + .tag-group { margin-top: clamp(3rem, 7vw, 5rem); padding-top: clamp(2rem, 5vw, 3.5rem); border-top: 1px solid var(--color-mist); }
  .tag-group h2 { margin: .4rem 0 1.5rem; font: 600 clamp(1.5rem, 3vw, 2.2rem)/1.35 var(--font-brand-display); color: var(--color-ink); }
  .tag-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 2.5rem); }
  .empty { font-size: var(--step-1); padding-block: 2rem; }
  @media (max-width: 1000px) { .tag-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .tag-grid { grid-template-columns: 1fr; } }
</style>
