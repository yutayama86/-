{
  // Cloudflare Workers（静的アセット配信）でイバトコを公開するための設定。
  // Astroのビルド成果物 dist/ を配信し、その手前で worker/index.js が
  // パスワード保護（Basic認証）を行います。
  "name": "ibatoco",
  "compatibility_date": "2024-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 全リクエストでまずWorkerを実行（パスワード保護のため）
    "run_worker_first": true,
    // 未知のURLは自作の404ページ（dist/404.html）を返す
    "not_found_handling": "404-page"
  }
}
